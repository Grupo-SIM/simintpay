BACKEND_IMAGE=ghcr.io/your-org/simintpay-back:sha-REPLACE_WITH_COMMIT
STORAGE_VOLUME_NAME=back-simpay_simpay_storage
NODE_ENV=production
PORT=3333
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
PLATFORM_CONFIG_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
FRONTEND_URL=https://YOUR_FRONTEND_HOST
RABBITMQ_URL=amqp://USER:PASSWORD@HOST:5672
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
