{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "generate": { "cache": false },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "generate"],
      "cache": false
    },
    "dev": { "dependsOn": ["generate"], "cache": false, "persistent": true },
    "test:unit": { "dependsOn": ["generate"], "cache": false },
    "start": { "cache": false, "persistent": true }
  }
}
