# Database
# Dev: localhost | Prod: usar pgbouncer na rede interna Docker
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bff_simpay?schema=public"

# Bancos externos: cadastrar Platform e integração EXTERNAL_DATABASE_URL via API admin.
# URL armazenada criptografada; detalhes em docs/business-rules.md.

# JWT (gerar um secret forte e único para o BFF)
JWT_SECRET=your-jwt-secret-here-min-32-chars

# Server
PORT=3001
NODE_ENV=development
# Dev: localhost | Prod: domínio do frontend
FRONTEND_URL=http://localhost:3000

# API DOM
# Se o BFF estiver na mesma rede Docker: http://api_dom:3333
# Se estiver fora ou em dev local: https://api-dom.jbmidia.com
API_DOM_URL=https://api-dom.jbmidia.com
API_DOM_MASTER_KEY=MASTER_KEY_DOM_API

# API real do DOM Pagamentos (apiv3.dompagamentos.com.br)
# Token Bearer gerado no painel DOM ou fornecido pelo time de integração
DOM_TOKEN=seu_token_dom_aqui
# URL base da API real (padrão já configurado, altere apenas se necessário)
DOM_REAL_API_URL=https://apiv3.dompagamentos.com.br/checkout/production

# Webhook (deve ser igual ao BFF_WEBHOOK_SECRET configurado na api-dom)
WEBHOOK_SECRET=simpay-bff-webhook-secret-change-me-in-production-64chars-minimum-ok

# Callback de status dos pagamentos Zero Grau

# RabbitMQ (mesmo da api-dom, na rede Docker interna)
RABBITMQ_URL=amqp://admin:55sQEVl68SCyMzR@rabbitmq:5672

# Redis (mesmo da api-dom, na rede Docker interna)
# Dev: redis://localhost:6379 | Prod: redis://redis_renovada:6379
REDIS_URL=redis://redis_renovada:6379

# SMTP (e-mail de boas-vindas ao aprovar leads)
SMTP_HOST=177.154.190.249
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@jbmidia.com
SMTP_FROM_EMAIL=noreply@jbmidia.com
SMTP_PASSWORD=your-smtp-password

# URL pública do frontend (usada nos links dos e-mails)
APP_URL=https://app.simpay.com.br

# Seed — admin inicial (usado pelo script prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@simpay.com.br
SEED_ADMIN_PASSWORD=troque-essa-senha
SEED_ADMIN_NAME=Admin

# Token compartilhado com o return-bet para o endpoint interno de verificação
# de comunidade (src/modules/return-bet). Gere um valor aleatório forte e
# configure o mesmo valor em return-bet/apps/api como SIMINTPAY_INTERNAL_TOKEN.

# Chave AES-256-GCM: 64 caracteres hexadecimais, preserve para ler configurações no banco.
PLATFORM_CONFIG_ENCRYPTION_KEY=

# Web Push (generate locally: node node_modules/web-push/src/cli.js generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@example.com

# Delivery canonical bootstrap/profile (configure profile with explicit operator script)
SIM_DELIVERY_PROVISIONING_TOKEN=
DELIVERY_DOM_TOKEN=
SIM_DELIVERY_CANONICAL_WEBHOOK_URL=
