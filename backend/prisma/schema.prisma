generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  productOwnershipFrom ProductOwnershipChange[] @relation("ProductOwnershipFrom")
  productOwnershipTo ProductOwnershipChange[] @relation("ProductOwnershipTo")
  coproductionAgreementEdits CoproductionAgreement[] @relation("CoproductionAgreementActor")
  coproductionRevisions CoproductionRevision[] @relation("CoproductionRevisionActor")
  coproductionAllocations CoproductionAllocation[]
  id                   String               @id @default(uuid())
  name                 String
  email                String               @unique
  password             String
  role                 Role                 @default(USER)
  clientStatus         ClientStatus?
  clientApprovedAt     DateTime?
  isCompany            Boolean              @default(false)
  /// Conta que já aparece em "Clientes Simintpay" (plataforma/comunidade): some da lista de Usuários ativos.
  isSimintpayClient    Boolean              @default(false)
    isActive             Boolean              @default(true)
    billingExcluded      Boolean              @default(false)
    isPurged             Boolean              @default(false)
    purgedAt             DateTime?
    purgedAmount         Decimal?             @db.Decimal(12, 2)
    domUserId            String?              @unique
  domToken             String?
  platformId           String?
  cpf                  String?              @unique
  cnpj                 String?              @unique
  isAffiliate          Boolean              @default(false)
  affiliateCommissionPercent Decimal?       @db.Decimal(5, 2)
  affiliateCode        String?              @unique
  referredByUserId     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  balanceLogs          BalanceLog[]
  customers            Customer[]
  paymentLinks         PaymentLink[]
  boletos              Boleto[]
  plans                Plan[]
  sessions             Session[]
  subscriptions        Subscription[]
  transactions         Transaction[]
  wallet               Wallet?
  withdrawals          WithdrawRequest[]
  platform             Platform?            @relation("PlatformMembers", fields: [platformId], references: [id], onDelete: SetNull)
  pixCreditPlans         PixCreditPlan[]
  pixPlanOrders          PixPlanOrder[]
  customerPlanAccesses   CustomerPlanAccess[]
  subscriptionLinks      SubscriptionLink[]
  subscriptionLinkOrders SubscriptionLinkOrder[]
  communityAccesses      CommunityAccess[]
  communityEvents        CommunitySubscriptionEvent[]
  externalPlatformUsers  ExternalPlatformUser[]
  vouchers               Voucher[]
  cobrancas              Cobranca[]
  referredBy             User?                @relation("AffiliateReferrals", fields: [referredByUserId], references: [id])
  referrals              User[]               @relation("AffiliateReferrals")
  affiliateCommissionsEarned AffiliateCommission[] @relation("AffiliateCommissionsEarned")
  affiliateCommissionsGenerated AffiliateCommission[] @relation("AffiliateCommissionsGenerated")
  billingContracts       BillingContract[]
  returnBetAccount       ReturnBetAccount?
  integrationMerchant    IntegrationMerchant?
  ownedPlatforms         Platform[] @relation("PlatformOwner")

  pushSubscriptions PushSubscription[]
  salePushEvents SalePushEvent[]

  @@index([email])
  @@index([domUserId])
  @@index([platformId])
  @@index([clientStatus])
  @@index([isCompany])
  @@index([isSimintpayClient])
  @@index([referredByUserId])
  @@index([affiliateCode])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model Wallet {
  id            String   @id @default(uuid())
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  lockedBalance Decimal  @default(0) @db.Decimal(12, 2)
  version       Int      @default(0)
  userId        String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

/// Cobrança lançada pelo Master para um cliente (débito do saldo ou, na Fase 2, cobrança a pagar).
model Cobranca {
  id              String         @id @default(uuid())
  userId          String
  amount          Decimal        @db.Decimal(12, 2)
  description     String?
  mode            CobrancaMode   @default(DEBIT)
  status          CobrancaStatus @default(APPLIED)
  createdByUserId String
  saldoAntes      Decimal?       @db.Decimal(12, 2)
  saldoDepois     Decimal?       @db.Decimal(12, 2)
  ficouNegativo   Boolean        @default(false)
  // Fase 2 (cobrança a pagar via PIX/cartão):
  dueDate         DateTime?
  paymentRef      String?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum CobrancaMode {
  DEBIT
  PAYABLE
}

enum CobrancaStatus {
  APPLIED
  PENDING
  PAID
  CANCELED
}

model BalanceLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  transactionId String?
  /// Administrative nominal accounting, never included in wallet sums.
  bookkeepingAmount Decimal? @db.Decimal(12, 2)
  balanceDelta  Decimal  @db.Decimal(12, 2)
  lockedDelta   Decimal  @db.Decimal(12, 2)
  description   String?
  source        String
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@index([createdAt])
}

model Transaction {
  coproductionAllocations CoproductionAllocation[]
  financialSnapshot Json?
  id               String                     @id @default(uuid())
  userId           String
  amount           Decimal                    @db.Decimal(12, 2)
  settlementBasis String?
  netAmount        Decimal?                   @db.Decimal(12, 2)
  status           TransactionStatus          @default(DRAFT)
  previousStatus   TransactionStatus?
  paymentMethod    PaymentMethod              @default(PIX)
  description      String?
  installments     Int                        @default(1)
  totalFee         Decimal                    @default(0) @db.Decimal(12, 2)
  domFee           Decimal                    @default(0) @db.Decimal(12, 2)
  platformFee      Decimal                    @default(0) @db.Decimal(12, 2)
  domTransactionId String?                    @unique
  domPaymentId     String?                    @unique
  // ── Múltiplas adquirentes ──
  // `acquirer` identifica quem processou (default DOM p/ retrocompat). Os campos
  // `external*` são os IDs neutros da adquirente — para a DOM espelham os `dom*`
  // acima; para a Frendz guardam o `hash` da transação. O webhook localiza a
  // transação por (acquirer, externalPaymentId).
  acquirer              Acquirer @default(DOM)
  externalTransactionId String?
  externalPaymentId     String?
  pixQrCode        String?
  pixContent       String?
  pixExpire        DateTime?
  cardBrand        String?
  cardBin          String?
  cardCodeAuth     String?
  customerName     String?
  customerEmail    String?
  customerDocument String?
  customerPhone    String?
  tracking         Json?
  /// Canonical platform tag (hyphenated, e.g. ZERO-GRAU). Filled from the [TENANT:x] marker of the
  /// description on insert and by the migration backfill; editable afterwards.
  platformTag      String?
  paymentLinkId    String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  paymentLink      PaymentLink?               @relation(fields: [paymentLinkId], references: [id])
  user             User                       @relation(fields: [userId], references: [id])
  salePushEvents SalePushEvent[]
  statusHistory    TransactionStatusHistory[]
  pixPlanOrder     PixPlanOrder?
  billingQuantityChange BillingQuantityChange?

  @@index([userId])
  @@index([status])
  @@index([domPaymentId])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([acquirer])
  @@index([acquirer, externalPaymentId])
  @@index([platformTag])
}

model TransactionStatusHistory {
  id            String            @id @default(uuid())
  transactionId String
  fromStatus    TransactionStatus
  toStatus      TransactionStatus
  metadata      Json?
  createdAt     DateTime          @default(now())
  transaction   Transaction       @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

model WithdrawRequest {
  id              String         @id @default(uuid())
  userId          String
  amount          Decimal        @db.Decimal(12, 2)
  grossAmount     Decimal        @db.Decimal(12, 2)
  fee             Decimal        @default(2.00) @db.Decimal(12, 2)
  status          WithdrawStatus @default(PENDING)
  pixKey          String
  receiptImage       String?
  comprovanteVisivel Boolean  @default(true)
  rejectionReason    String?
  domWithdrawId   String?        @unique
  platform        String?        @db.VarChar(50)
  // ── Múltiplas adquirentes ──
  // `acquirer` indica por onde o saque é processado (default DOM). `externalWithdrawId`
  // é o ID neutro do saque na adquirente (para a Frendz, o `transferHash`).
  acquirer           Acquirer @default(DOM)
  externalWithdrawId String?
  integrationRequestId String?        @unique
  remainingBalanceAfterWithdrawal Decimal? @db.Decimal(12, 2)
  sourceBalanceSnapshot Decimal?      @db.Decimal(12, 2)
  reviewedAt            DateTime?
  reviewSource          String?
  reviewedByReference   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])
  integrationWebhookDeliveries IntegrationWebhookDelivery[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([platform])
  @@index([acquirer])
}

/// Merchant provisioned by an authenticated server-to-server integration.
model IntegrationMerchant {
  id                 String   @id @default(uuid())
  integrationKey     String
  externalMerchantId String
  legalName          String
  cnpj               String?
  userId             String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookDeliveries  IntegrationWebhookDelivery[]

  @@unique([integrationKey, externalMerchantId])
  @@unique([integrationKey, cnpj])
  @@index([integrationKey])
}

/// Durable callback delivery. Unique status snapshots make retries idempotent.
model IntegrationWebhookDelivery {
  id           String   @id @default(uuid())
  merchantId   String
  withdrawalId String
  status       String
  payload      Json
  attempts     Int      @default(0)
  nextAttemptAt DateTime @default(now())
  deliveredAt  DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  merchant     IntegrationMerchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  withdrawal   WithdrawRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@unique([withdrawalId, status])
  @@index([deliveredAt, nextAttemptAt])
}

model PaymentLink {
  /// Executor only; userId remains the financial beneficiary. Null for unaudited legacy rows.
  createdByUserId String?
  id               String        @id @default(uuid())
  userId           String
  code             String        @unique @default(uuid())
  title            String
  description      String?
  amount           Decimal       @db.Decimal(12, 2)
  expiresAt        DateTime?
  maxInstallments  Int           @default(1)
  aceitaCartao     Boolean       @default(true)
  aceitaDebito     Boolean       @default(true)
  aceitaPix        Boolean       @default(true)
  isActive         Boolean       @default(true)
  isStandalone     Boolean       @default(true)
  platformFee1x    Float         @default(9.00)
  platformFee2x    Float         @default(13.30)
  platformFee3x    Float         @default(14.68)
  platformFee4x    Float         @default(16.04)
  platformFee5x    Float         @default(17.37)
  platformFee6x    Float         @default(18.67)
  platformFee7x    Float         @default(19.95)
  platformFee8x    Float         @default(21.21)
  platformFee9x    Float         @default(22.44)
  platformFee10x   Float         @default(23.64)
  platformFee11x   Float         @default(24.83)
  platformFee12x   Float         @default(25.99)
  cashbackFee      Float         @default(3.00)
  debitFeePercent  Float         @default(2.00)
  debitFeeFixed    Float         @default(2.00)
  webhookUrl       String?
  /// URL aberta em nova aba quando o pagamento é aprovado (redirecionamento pós-checkout)
  redirectUrl      String?
  maxUses          Int?
  currentUses      Int           @default(0)
  domPaymentLinkId String?       @unique
  /// Corpo de e-mail personalizado enviado ao comprador (apenas itens de ebook)
  emailBody        String?
  /// Plataformas associadas a este link de pagamento (ex: ["AREAFLIX", "PAGATG"])
  plataformas      String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])
  transactions     Transaction[]
  communityBindings CommunityLinkBinding[]
  files            PaymentLinkFile[]
  offers           PaymentLinkOffer[]

  @@index([userId])
  @@index([code])
}

/// Oferta extra de um link de pagamento: ORDER_BUMP (somada ao pedido no checkout),
/// UPSELL (oferecida após a aprovação) ou DOWNSELL (oferecida quando o upsell é recusado).
model PaymentLinkOffer {
  id            String      @id @default(uuid())
  paymentLinkId String
  paymentLink   PaymentLink @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  /// ORDER_BUMP | UPSELL | DOWNSELL
  type          String
  /// Chamada em destaque (ex: "POR QUE NÃO DOBRAR A SUA RENDA?")
  headline      String?
  title         String
  description   String?
  imageUrl      String?
  /// Mensagem do e-mail de entrega desta oferta (ex.: link de acesso)
  emailBody     String?
  price         Decimal     @db.Decimal(12, 2)
  /// Preço "de" exibido riscado (opcional)
  originalPrice Decimal?    @db.Decimal(12, 2)
  position      Int         @default(0)
  isActive      Boolean     @default(true)
  /// Remoção lógica — ofertas removidas no painel nunca são apagadas fisicamente
  deletedAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  files         PaymentLinkOfferFile[]

  @@index([paymentLinkId])
}

/// PDFs entregues por e-mail ao comprador desta oferta
model PaymentLinkOfferFile {
  id        String           @id @default(uuid())
  offerId   String
  offer     PaymentLinkOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  createdAt DateTime         @default(now())

  @@index([offerId])
}

/// Registro de cada oferta vendida (order bump no pedido principal; upsell/downsell em cobrança própria).
/// Guarda snapshot de título/preço para não depender da oferta continuar existindo.
model PaymentLinkOfferSale {
  id                  String   @id @default(uuid())
  offerId             String
  paymentLinkId       String
  transactionId       String
  /// Transação do pedido principal (upsell/downsell); null para order bump
  parentTransactionId String?
  type                String
  title               String
  price               Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  @@index([transactionId])
  @@index([parentTransactionId])
  @@index([offerId])
}

/// Cobrança por boleto — espelha o Link de Pagamento, mas cobra via boleto (à vista, sem parcelas).
/// Criado na DOM Pagamentos via set-payment-link com paymentConfig.boleto = true.
model Boleto {
  /// Executor only; userId remains the financial beneficiary. Null for unaudited legacy rows.
  createdByUserId String?
  id               String   @id @default(uuid())
  userId           String
  code             String   @unique @default(uuid())
  title            String
  description      String?
  amount           Decimal  @db.Decimal(12, 2)
  expiresAt        DateTime?
  /// Dias até o vencimento do boleto (boletoExpireDay na DOM)
  vencimentoDias   Int      @default(3)
  isActive         Boolean  @default(true)
  webhookUrl       String?
  redirectUrl      String?
  maxUses          Int?
  currentUses      Int      @default(0)
  domPaymentLinkId String?  @unique
  /// Link hospedado da DOM (checkout do boleto)
  domLink          String?
  /// Plataformas associadas (ex.: ["SIMINTPAY", "AREAFLIX"])
  plataformas      String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([code])
}

model PaymentLinkFile {
  id            String      @id @default(uuid())
  paymentLinkId String
  paymentLink   PaymentLink @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileSize      Int
  createdAt     DateTime    @default(now())

  @@index([paymentLinkId])
}

// ── Subscription Link (link de assinatura com recorrência) ───────────────────
model SubscriptionLink {
  /// Executor only; userId remains the financial beneficiary. Null for unaudited legacy rows.
  createdByUserId String?
  id            String    @id @default(uuid())
  userId        String
  code          String    @unique @default(uuid())
  /// E-mail da conta dona do link (para resolver userId por email)
  ownerEmail    String?
  name          String
  description   String?
  amount        Decimal   @db.Decimal(12, 2)
  frequencyType PlanType
  /// true = Avulso (cliente paga valor sem juros); false = Plataforma (aplica platformFee)
  isStandalone    Boolean   @default(true)
  platformFee     Float     @default(9.00)
  isActive        Boolean   @default(true)
  redirectUrl     String?
  webhookUrl      String?
  maxUses         Int?
  currentUses     Int       @default(0)
  domPlanId       String?   @unique
  /// Corpo de e-mail personalizado enviado ao comprador (apenas itens de ebook)
  emailBody       String?
  /// Métodos aceitos: PIX, CREDIT_CARD ou BOTH (padrão)
  paymentMethods  String    @default("BOTH")
  /// Tag de plataforma para resolução de taxa (ex: AREAFLIX, COMUNIDADE, GLOBAL)
  platformTag     String?
  /// Plataformas associadas a este link (ex: ["AREAFLIX", "PAGATG"])
  plataformas     String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
  subscriptions SubscriptionLinkOrder[]
  communityBindings CommunityLinkBinding[]

  @@index([userId])
  @@index([code])
}

/// Registro de cada assinatura originada por um SubscriptionLink
model SubscriptionLinkOrder {
  financialSnapshot Json?
  id                  String    @id @default(uuid())
  subscriptionLinkId  String
  userId              String
  customerName        String
  customerEmail       String
  customerDocument    String
  customerPhone       String?
  paymentMethod       PaymentMethod @default(CREDIT_CARD)
  status              String    @default("pending")
  domSubscriptionId   String?   @unique
  domPixPaymentId     String?   @unique
  pixContent          String?
  pixExpire           DateTime?
  amountCharged       Decimal   @db.Decimal(12, 2)
  platformFeeAmount   Decimal   @default(0) @db.Decimal(12, 2)
  currentPeriodEndsAt DateTime?
  issueStartedAt      DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  subscriptionLink    SubscriptionLink @relation(fields: [subscriptionLinkId], references: [id])
  user                User      @relation(fields: [userId], references: [id])
  communityEvents     CommunitySubscriptionEvent[]

  @@index([subscriptionLinkId])
  @@index([userId])
  @@index([customerEmail])
}

/// Conta técnica usada exclusivamente para inserir saques do Return Bet na
/// fila financeira da Simintpay sem permitir login ao cliente externo.
model ReturnBetAccount {
  id             String   @id @default(uuid())
  externalUserId String   @unique
  userId         String   @unique
  name           String
  email          String
  document       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([document])
  @@index([email])
}

/// Política financeira exclusiva do Return Bet. Uma única linha, mantida pelo
/// admin Return Bet via integração interna autenticada.
model ReturnBetWithdrawalPolicy {
  id                 String   @id
  minimumGrossAmount Decimal  @default(100) @db.Decimal(12, 2)
  fixedWithdrawalFee Decimal  @default(2) @db.Decimal(12, 2)
  withdrawalWindowDays Int    @default(30)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Community {
  id          String                @id @default(uuid())
  slug        String                @unique
  name        String
  description String?
  source      CommunitySource       @default(AUTOMATIC)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  bindings    CommunityLinkBinding[]
  accesses    CommunityAccess[]
  events      CommunitySubscriptionEvent[]

  @@index([slug])
}

model CommunityLinkBinding {
  id                 String            @id @default(uuid())
  communityId        String
  bindingType        CommunityLinkType
  subscriptionLinkId String?
  paymentLinkId      String?
  isManual           Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  community          Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  subscriptionLink   SubscriptionLink? @relation(fields: [subscriptionLinkId], references: [id], onDelete: Cascade)
  paymentLink        PaymentLink?      @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([subscriptionLinkId])
  @@index([paymentLinkId])
}

model CommunityAccess {
  id               String          @id @default(uuid())
  communityId      String
  userId           String
  status           CommunityStatus @default(ATIVA)
  isActive         Boolean         @default(true)
  statusReason     String?
  startedAt        DateTime
  expiresAt        DateTime
  totalDaysCredited Int            @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  community        Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@index([isActive])
}

model CommunitySubscriptionEvent {
  id                      String                   @id @default(uuid())
  communityId             String
  userId                  String
  eventType               CommunityEventType
  paymentMethod           PaymentMethod?
  amountCharged           Decimal?                 @db.Decimal(12, 2)
  subscriptionLinkOrderId String?
  metadata                Json?
  createdAt               DateTime                 @default(now())
  community               Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionLinkOrder   SubscriptionLinkOrder?   @relation(fields: [subscriptionLinkOrderId], references: [id], onDelete: SetNull)

  @@index([communityId])
  @@index([userId])
  @@index([eventType])
}

model Plan {
  /// Executor only; userId remains the financial beneficiary. Null for unaudited legacy rows.
  createdByUserId String?
  id            String         @id @default(uuid())
  userId        String
  name          String
  description   String?
  price         Decimal        @db.Decimal(12, 2)
  type          PlanType
  frequency     Int?
  repetitions   Int?
  retryDays     Int?
  isActive      Boolean        @default(true)
  webhookUrl    String?
  redirectUrl   String?
  domPlanId      String?        @unique
  code           String?        @unique
  paymentMethods String?        @default("BOTH")
  /// Corpo de e-mail personalizado enviado ao comprador (apenas itens de ebook)
  emailBody      String?
  /// Plataformas associadas a este plano (ex: ["AREAFLIX", "PAGATG"])
  plataformas    String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  subscriptions Subscription[]

  @@index([userId])
}

model Subscription {
  financialSnapshot Json?
  id                String    @id @default(uuid())
  userId            String
  planId            String
  customerId        String?
  status            String    @default("active")
  expiresAt         DateTime?
  totalDaysCredited Int       @default(0)
  domSubscriptionId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  customer          Customer? @relation(fields: [customerId], references: [id])
  plan              Plan      @relation(fields: [planId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
}

/// Contrato comercial recorrente associado a um recurso faturável externo.
/// O núcleo de billing não conhece o domínio consumidor (workspace, licença etc.);
/// `resourceType + resourceId` formam a identidade neutra do recurso.
model BillingContract {
  id                     String                @id @default(uuid())
  userId                 String
  resourceType           String                @db.VarChar(50)
  resourceId             String                @db.VarChar(191)
  priceKey               String?               @db.VarChar(100)
  pricingVersion         Int?
  currency               String                @default("BRL") @db.VarChar(3)
  baseAmount             Decimal               @default(0) @db.Decimal(12, 2)
  unitAmount             Decimal               @db.Decimal(12, 2)
  quantity               Int
  pendingQuantity        Int?
  minimumQuantity        Int                   @default(1)
  intervalType           BillingIntervalType   @default(MONTH)
  intervalCount          Int                   @default(1)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  status                 BillingContractStatus @default(ACTIVE)
  pastDueAt              DateTime?
  graceEndsAt            DateTime?
  suspendedAt            DateTime?
  accessEndsAt           DateTime?
  version                Int                   @default(1)
  acquirer               Acquirer              @default(DOM)
  externalPlanId         String?
  externalSubscriptionId String                 @unique
  description            String?
  metadata               Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id])
  changes                BillingQuantityChange[]
  events                 BillingContractEvent[]

  @@unique([resourceType, resourceId])
  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}

model BillingContractEvent {
  id          String   @id @default(uuid())
  contractId  String
  eventKey    String   @unique @db.VarChar(191)
  type        String   @db.VarChar(80)
  payload     Json
  deliveredAt DateTime?
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  contract    BillingContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, deliveredAt])
}

/// Operação idempotente e auditável de mudança de quantidade recorrente.
model BillingQuantityChange {
  id                      String                      @id @default(uuid())
  contractId              String
  idempotencyKey          String                      @db.VarChar(191)
  requestHash             String                      @db.VarChar(64)
  expectedVersion         Int
  previousQuantity        Int
  targetQuantity          Int
  effectiveAt             DateTime
  scheduledFor            DateTime?
  periodStart             DateTime
  periodEnd               DateTime
  remainingRatio          Decimal                     @db.Decimal(20, 10)
  previousRecurringAmount Decimal                     @db.Decimal(12, 2)
  nextRecurringAmount     Decimal                     @db.Decimal(12, 2)
  prorationAmount         Decimal                     @db.Decimal(12, 2)
  status                  BillingQuantityChangeStatus
  transactionId           String?                     @unique
  externalPaymentId       String?
  externalPlanId          String?
  externalSubscriptionId  String?
  failureCode             String?
  failureMessage          String?
  processingStartedAt     DateTime?
  calculationSnapshot     Json
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  contract                BillingContract             @relation(fields: [contractId], references: [id])
  transaction             Transaction?                @relation(fields: [transactionId], references: [id])

  @@unique([contractId, idempotencyKey])
  @@index([contractId, status])
  @@index([scheduledFor, status])
}

/// Guarda o estado de pausa de uma assinatura DOM.
/// Criado ao pausar (após cancelar na DOM) e destruído ao retomar.
/// Não toca em nada do fluxo normal — só existe se o admin pausar.
model SubscriptionPause {
  id                String   @id @default(uuid())
  /// ID da assinatura na DOM (mesmo campo usado em Subscription.domSubscriptionId)
  domSubscriptionId String   @unique
  userId            String
  /// Snapshot dos dados de exibição (a assinatura some da listagem DOM após cancelamento)
  subscriberName    String?
  customerEmail     String?
  description       String?
  planId            String?
  valueBrl          Float?
  frequency         String?
  interval          Int      @default(1)
  plataforma        String?
  firstCharge       String?
  /// Dias restantes calculados no momento da pausa (expiresAt - pausedAt)
  remainingDays     Int
  pausedAt          DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

/// Assinaturas inativas que o admin master optou por ocultar do histórico.
/// O registro na DOM não é alterado; a exclusão vale apenas para esta listagem.
model SubscriptionHistoryExclusion {
  id                String   @id @default(uuid())
  domSubscriptionId String   @unique
  removedByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([removedByUserId])
}

model Customer {
  id                   String               @id @default(uuid())
