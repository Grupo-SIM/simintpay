generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  productOwnershipFrom ProductOwnershipChange[] @relation("ProductOwnershipFrom")
  productOwnershipTo ProductOwnershipChange[] @relation("ProductOwnershipTo")
  coproductionAgreementEdits CoproductionAgreement[] @relation("CoproductionAgreementActor")
  coproductionRevisions CoproductionRevision[] @relation("CoproductionRevisionActor")
  coproductionAllocations CoproductionAllocation[]
  id                   String               @id @default(uuid())
  name                 String
  email                String               @unique
  password             String
  role                 Role                 @default(USER)
  clientStatus         ClientStatus?
  clientApprovedAt     DateTime?
  isCompany            Boolean              @default(false)
  phone                String?
  /// Conta que já aparece em "Clientes Simintpay" (plataforma/comunidade): some da lista de Usuários ativos.
  isSimintpayClient    Boolean              @default(false)
    isActive             Boolean              @default(true)
    billingExcluded      Boolean              @default(false)
    isPurged             Boolean              @default(false)
    purgedAt             DateTime?
    purgedAmount         Decimal?             @db.Decimal(12, 2)
    domUserId            String?              @unique
  platformId           String?
  cpf                  String?              @unique
  cnpj                 String?              @unique
  isAffiliate          Boolean              @default(false)
  affiliateCommissionPercent Decimal?       @db.Decimal(5, 2)
  affiliateCode        String?              @unique
  referredByUserId     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  balanceLogs          BalanceLog[]
  customers            Customer[]
  sessions             Session[]
  transactions         Transaction[]
  wallet               Wallet?
  withdrawals          WithdrawRequest[]
  platform             Platform?            @relation("PlatformMembers", fields: [platformId], references: [id], onDelete: SetNull)
  externalPlatformUsers  ExternalPlatformUser[]
  vouchers               Voucher[]
  cobrancas              Cobranca[]
  referredBy             User?                @relation("AffiliateReferrals", fields: [referredByUserId], references: [id])
  referrals              User[]               @relation("AffiliateReferrals")
  affiliateCommissionsEarned AffiliateCommission[] @relation("AffiliateCommissionsEarned")
  affiliateCommissionsGenerated AffiliateCommission[] @relation("AffiliateCommissionsGenerated")
  billingContracts       BillingContract[]
  ownedOffers            Offer[]               @relation("OfferOwner")
  integrationMerchant    IntegrationMerchant?
  ownedPlatforms         Platform[] @relation("PlatformOwner")

  pushSubscriptions PushSubscription[]
  salePushEvents SalePushEvent[]

  @@index([email])
  @@index([domUserId])
  @@index([platformId])
  @@index([clientStatus])
  @@index([isCompany])
  @@index([isSimintpayClient])
  @@index([referredByUserId])
  @@index([affiliateCode])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model Wallet {
  id            String   @id @default(uuid())
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  lockedBalance Decimal  @default(0) @db.Decimal(12, 2)
  version       Int      @default(0)
  userId        String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

/// Cobrança lançada pelo Master para um cliente (débito do saldo ou, na Fase 2, cobrança a pagar).
model Cobranca {
  id              String         @id @default(uuid())
  userId          String
  amount          Decimal        @db.Decimal(12, 2)
  description     String?
  mode            CobrancaMode   @default(DEBIT)
  status          CobrancaStatus @default(APPLIED)
  createdByUserId String
  saldoAntes      Decimal?       @db.Decimal(12, 2)
  saldoDepois     Decimal?       @db.Decimal(12, 2)
  ficouNegativo   Boolean        @default(false)
  // Fase 2 (cobrança a pagar via PIX/cartão):
  dueDate         DateTime?
  paymentRef      String?
  paidAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum CobrancaMode {
  DEBIT
  PAYABLE
}

enum CobrancaStatus {
  APPLIED
  PENDING
  PAID
  CANCELED
}

/// Trilha de auditoria do "Acessar como" do admin master.
model AdminAccessLog {
  id           String   @id @default(uuid())
  adminId      String
  targetUserId String
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
}

model BalanceLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  /// Explicit ledger attribution only; null preserves unclassified legacy history.
  platformTag   String?
  /// Internal WalletEntryNature contract; null means unclassified.
  nature        String?
  transactionId String?
  /// Administrative nominal accounting, never included in wallet sums.
  bookkeepingAmount Decimal? @db.Decimal(12, 2)
  balanceDelta  Decimal  @db.Decimal(12, 2)
  lockedDelta   Decimal  @db.Decimal(12, 2)
  description   String?
  source        String
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@index([createdAt])
  @@index([userId, platformTag, nature])
}

model Transaction {
  coproductionAllocations CoproductionAllocation[]
  financialSnapshot Json?
  id               String                     @id @default(uuid())
  userId           String
  amount           Decimal                    @db.Decimal(12, 2)
  settlementBasis String?
  netAmount        Decimal?                   @db.Decimal(12, 2)
  status           TransactionStatus          @default(DRAFT)
  previousStatus   TransactionStatus?
  paymentMethod    PaymentMethod              @default(PIX)
  description      String?
  installments     Int                        @default(1)
  totalFee         Decimal                    @default(0) @db.Decimal(12, 2)
  acquirerFee      Decimal                    @default(0) @db.Decimal(12, 2)
  platformFee      Decimal                    @default(0) @db.Decimal(12, 2)
  domTransactionId String?                    @unique
  domPaymentId     String?                    @unique
  // ── Múltiplas adquirentes ──
  // `acquirer` identifica quem processou (default DOM p/ retrocompat). Os campos
  // `external*` são os IDs neutros da adquirente — para a DOM espelham os `dom*`
  // acima; para a Frendz guardam o `hash` da transação. O webhook localiza a
  // transação por (acquirer, externalPaymentId).
  acquirer              Acquirer @default(DOM)
  externalTransactionId String?
  externalPaymentId     String?
  pixQrCode        String?
  pixContent       String?
  pixExpire        DateTime?
  cardBrand        String?
  cardBin          String?
  cardCodeAuth     String?
  customerName     String?
  customerEmail    String?
  customerDocument String?
  customerPhone    String?
  tracking         Json?
  /// Canonical platform tag (hyphenated, e.g. ZERO-GRAU). Filled from the [TENANT:x] marker of the
  /// description on insert and by the migration backfill; editable afterwards.
  platformTag      String?
  /// Offer that originated the sale.
  offerId          String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  offer            Offer?                     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  user             User                       @relation(fields: [userId], references: [id])
  salePushEvents SalePushEvent[]
  statusHistory    TransactionStatusHistory[]
  paymentAttempts  PaymentAttempt[]
  billingQuantityChange BillingQuantityChange?
  charge                Charge?

  @@index([userId])
  @@index([offerId])
  @@index([status])
  @@index([domPaymentId])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([acquirer])
  @@index([acquirer, externalPaymentId])
  @@index([platformTag])
}

enum PaymentAttemptStatus {
  RESERVED
  DISPATCHING
  UNKNOWN
  PRE_CREATION_FAILED
  TERMINAL_NONPAYABLE
  ACCEPTED
  SUCCEEDED
  FAILED
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  transactionId     String
  transaction       Transaction          @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  sequence          Int
  externalReference String               @unique
  provider          Acquirer
  status            PaymentAttemptStatus
  evidence          Json?
  leaseToken        String?
  leaseExpiresAt    DateTime?
  providerPaymentId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([transactionId, sequence])
  @@index([transactionId, status])
  @@unique([provider, providerPaymentId])
}

/// Durable per-lane circuit state shared by every backend replica.
model PaymentCircuitState {
  provider       String
  operation      String
  status         String   @default("CLOSED")
  fence          BigInt   @default(0)
  leaseToken     String?
  leaseExpiresAt DateTime?
  cooldownUntil  DateTime?
  openedAt       DateTime?
  updatedAt      DateTime @updatedAt

  @@id([provider, operation])
}

/// Immutable outcomes for the rolling failure window and operational inspection.
model PaymentCircuitEvent {
  token     String   @id
  provider  String
  operation String
  outcome   String
  probe     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([provider, operation, createdAt])
}

model TransactionStatusHistory {
  id            String            @id @default(uuid())
  transactionId String
  fromStatus    TransactionStatus
  toStatus      TransactionStatus
  metadata      Json?
  createdAt     DateTime          @default(now())
  transaction   Transaction       @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

model WithdrawRequest {
  id              String         @id @default(uuid())
  userId          String
  amount          Decimal        @db.Decimal(12, 2)
  grossAmount     Decimal        @db.Decimal(12, 2)
  fee             Decimal        @default(2.00) @db.Decimal(12, 2)
  status          WithdrawStatus @default(PENDING)
  pixKey          String
  receiptImage       String?
  comprovanteVisivel Boolean  @default(true)
  rejectionReason    String?
  domWithdrawId   String?        @unique
  platform        String?        @db.VarChar(50)
  // ── Múltiplas adquirentes ──
  // `acquirer` indica por onde o saque é processado (default DOM). `externalWithdrawId`
  // é o ID neutro do saque na adquirente (para a Frendz, o `transferHash`).
  acquirer           Acquirer @default(DOM)
  externalWithdrawId String?
  integrationRequestId String?        @unique
  remainingBalanceAfterWithdrawal Decimal? @db.Decimal(12, 2)
  sourceBalanceSnapshot Decimal?      @db.Decimal(12, 2)
  reviewedAt            DateTime?
  reviewSource          String?
  reviewedByReference   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])
  integrationWebhookDeliveries IntegrationWebhookDelivery[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([platform])
  @@index([acquirer])
}

/// Merchant provisioned by an authenticated server-to-server integration.
model IntegrationMerchant {
  id                 String   @id @default(uuid())
  integrationKey     String
  externalMerchantId String
  legalName          String
  cnpj               String?
  userId             String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookDeliveries  IntegrationWebhookDelivery[]

  @@unique([integrationKey, externalMerchantId])
  @@unique([integrationKey, cnpj])
  @@index([integrationKey])
}

/// Durable callback delivery. Unique status snapshots make retries idempotent.
model IntegrationWebhookDelivery {
  id           String   @id @default(uuid())
  merchantId   String
  withdrawalId String
  status       String
  payload      Json
  attempts     Int      @default(0)
  nextAttemptAt DateTime @default(now())
  deliveredAt  DateTime?
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  merchant     IntegrationMerchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  withdrawal   WithdrawRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@unique([withdrawalId, status])
  @@index([deliveredAt, nextAttemptAt])
}

/// Contrato comercial recorrente associado a um recurso faturável externo.
/// O núcleo de billing não conhece o domínio consumidor (workspace, licença etc.);
/// `resourceType + resourceId` formam a identidade neutra do recurso.
model BillingContract {
  id                     String                @id @default(uuid())
  userId                 String
  resourceType           String                @db.VarChar(50)
  resourceId             String                @db.VarChar(191)
  priceKey               String?               @db.VarChar(100)
  pricingVersion         Int?
  currency               String                @default("BRL") @db.VarChar(3)
  baseAmount             Decimal               @default(0) @db.Decimal(12, 2)
  unitAmount             Decimal               @db.Decimal(12, 2)
  quantity               Int
  pendingQuantity        Int?
  minimumQuantity        Int                   @default(1)
  intervalType           BillingIntervalType   @default(MONTH)
  intervalCount          Int                   @default(1)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  status                 BillingContractStatus @default(ACTIVE)
  pastDueAt              DateTime?
  graceEndsAt            DateTime?
  suspendedAt            DateTime?
  accessEndsAt           DateTime?
  /// Momento da pausa; nulo quando o contrato não está pausado.
  pausedAt               DateTime?
  /// Dias que faltavam no período quando foi pausado; retomar recalcula o período a partir deles.
  pausedRemainingDays    Int?
  version                Int                   @default(1)
  acquirer               Acquirer              @default(DOM)
  externalPlanId         String?
  /// Legacy gateway-side subscription. Contracts scheduled by SimIntPay itself leave it null.
  externalSubscriptionId String?                @unique
  description            String?
  metadata               Json?
  /// Offer this contract is a buyer's subscription to; null for API-integration contracts.
  offerId                String?
  nextChargeAt           DateTime?
  retryCount             Int                    @default(0)
  customerName           String?
  customerEmail          String?
  customerDocument       String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id])
  offer                  Offer?                 @relation(fields: [offerId], references: [id], onDelete: Restrict)
  changes                BillingQuantityChange[]
  events                 BillingContractEvent[]
  charges                Charge[]
  storedCards            StoredCard[]

  @@unique([resourceType, resourceId])
  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([nextChargeAt, status])
  @@index([offerId])
}

model BillingContractEvent {
  id          String   @id @default(uuid())
  contractId  String
  eventKey    String   @unique @db.VarChar(191)
  type        String   @db.VarChar(80)
  payload     Json
  deliveredAt DateTime?
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  contract    BillingContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, deliveredAt])
}

/// Operação idempotente e auditável de mudança de quantidade recorrente.
model BillingQuantityChange {
  id                      String                      @id @default(uuid())
  contractId              String
  idempotencyKey          String                      @db.VarChar(191)
  requestHash             String                      @db.VarChar(64)
  expectedVersion         Int
  previousQuantity        Int
  targetQuantity          Int
  effectiveAt             DateTime
  scheduledFor            DateTime?
  periodStart             DateTime
  periodEnd               DateTime
  remainingRatio          Decimal                     @db.Decimal(20, 10)
  previousRecurringAmount Decimal                     @db.Decimal(12, 2)
  nextRecurringAmount     Decimal                     @db.Decimal(12, 2)
  prorationAmount         Decimal                     @db.Decimal(12, 2)
  status                  BillingQuantityChangeStatus
  transactionId           String?                     @unique
  externalPaymentId       String?
  externalPlanId          String?
  externalSubscriptionId  String?
  failureCode             String?
  failureMessage          String?
  processingStartedAt     DateTime?
  calculationSnapshot     Json
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  contract                BillingContract             @relation(fields: [contractId], references: [id])
  transaction             Transaction?                @relation(fields: [transactionId], references: [id])

  @@unique([contractId, idempotencyKey])
  @@index([contractId, status])
  @@index([scheduledFor, status])
}

model Customer {
  id                   String               @id @default(uuid())
  userId               String
  name                 String
  email                String
  document             String
  documentType         String               @default("CPF")
  phone                String?
  domCustomerId        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id])

  @@unique([userId, document])
  @@index([email])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  source      String
  eventType   String
  payload     Json
  status      String    @default("PENDING")
  retryCount  Int       @default(0)
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([status])
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  webhookUrl         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Lead {
  id              String     @id @default(uuid())
  name            String
  phone           String
  email           String
  razaoSocial     String?
  cnpj            String?
  cpf             String?
  faturamento     String?
  tempoOperacao   String?
  modeloOperacao  String?
  cargo           String?
  comoConheceu    String?
  referredByCode  String?
  status          LeadStatus @default(PENDING)
  rejectionReason String?
  approvedUserId  String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([email])
  @@index([cnpj])
}

enum Role {
  USER
  ADMIN
}

enum ClientStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TransactionStatus {
  DRAFT
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  EXPIRED
  IN_MEDIATION
  CHARGEBACK
  PENDING_REFUND
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  BOLETO
}

/// Adquirente que processou a transação/saque.
/// DOM é o padrão histórico — registros antigos assumem DOM via @default.
enum Acquirer {
  DOM
  FRENDZ
}

enum BillingIntervalType {
  DAY
  WEEK
  MONTH
  YEAR
}

enum BillingContractStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  INACTIVE
  CANCELLED
  /// Pausada pelo vendedor ou admin: o ciclo não cobra e o tempo restante fica guardado.
  PAUSED
}

/// Who pays each cycle of a recurring offer.
enum RenewalMode {
  /// One-off purchase.
  NONE
  /// SimIntPay charges the buyer's stored card each cycle.
  AUTO_CHARGE
  /// SimIntPay issues PIX/boleto each cycle and the buyer pays it.
  MANUAL_PAY
}

enum ChargeStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum BillingQuantityChangeStatus {
  PENDING_PAYMENT
  PENDING_RECURRENCE_UPDATE
  SCHEDULED
  APPLIED
  FAILED
  COMPENSATION_REQUIRED
}

enum WithdrawStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

enum LeadStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── External Platform Users (donos de plataformas externas, ex: ebook) ────────
// Representa usuários identificados via CPF ou CNPJ nas descrições de transações.
// Quando o usuário se cadastra na Simpay com o mesmo documento, é feita a vinculação.
model ExternalPlatformUser {
  id          String                   @id @default(uuid())
  cpf         String?
  cnpj        String?
  name        String
  platform    String                   // slug da plataforma ex: "ebook"
  userId      String?                  // vinculado ao User da Simpay quando se cadastra
  isDeleted   Boolean                  @default(false)  // inativado (reversível)
  deletedAt   DateTime?
  // Exclusão permanente (irreversível): estado final, o saldo foi absorvido pelo master.
  // Não apagamos a linha — apagar mudaria o histórico/relatórios retroativamente.
  isPurged    Boolean                  @default(false)
  purgedAt    DateTime?
  purgedAmount Decimal?                @db.Decimal(12, 2)  // saldo absorvido no momento da exclusão
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  wallet      ExternalPlatformWallet?
  user        User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([cpf, platform])
  @@unique([cnpj, platform])
  @@index([cpf])
  @@index([cnpj])
  @@index([platform])
  @@index([userId])
}

model ExternalPlatformWallet {
  id                   String               @id @default(uuid())
  externalUserId       String               @unique
  balance              Decimal              @default(0) @db.Decimal(12, 2)
  lockedBalance        Decimal              @default(0) @db.Decimal(12, 2)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  externalUser         ExternalPlatformUser @relation(fields: [externalUserId], references: [id])
}

model PlatformTaxaOverride {
  id        String   @id @default(uuid())
  tag       String
  key       String
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tag, key])
  @@index([tag])
}

// ── Vouchers ──────────────────────────────────────────────────────────────────

model Voucher {
  id               String         @id @default(uuid())
  userId           String
  code             String
  description      String?
  discountType     DiscountType
  discountValue    Float
  maxUsage         Int?
  maxDiscountValue Float?
  validFrom        DateTime?
  validUntil       DateTime?
  applicablePlans  String[]
  minOrderValue    Float?
  allowedChannels  String[]       @default(["PAGATG"])
  allowedLinkCodes String[]       @default([])
  isActive         Boolean        @default(true)
  usageCount       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages           VoucherUsage[]

  @@unique([code])
  @@index([userId])
  @@index([code])
}

model VoucherUsage {
  id               String   @id @default(uuid())
  voucherId        String
  transactionId    String?
  subscriptionId   String?
  customerEmail    String
  customerDocument String
  originalAmount   Float
  discountAmount   Float
  finalAmount      Float
  createdAt        DateTime @default(now())
  voucher          Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId, transactionId])
  @@index([voucherId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ── Programa de Afiliados ───────────────────────────────────────────────────

model AffiliateCommission {
  id               String                    @id @default(uuid())
  affiliateUserId  String
  referredUserId   String
  transactionId    String                    @unique
  percentApplied   Decimal                   @db.Decimal(5, 2)
  grossPlatformFee Decimal                   @db.Decimal(12, 2)
  commissionAmount Decimal                   @db.Decimal(12, 2)
  status           AffiliateCommissionStatus @default(CREDITED)
  createdAt        DateTime                  @default(now())
  reversedAt       DateTime?
  affiliate        User                      @relation("AffiliateCommissionsEarned", fields: [affiliateUserId], references: [id])
  referredUser     User                      @relation("AffiliateCommissionsGenerated", fields: [referredUserId], references: [id])

  @@index([affiliateUserId])
  @@index([referredUserId])
  @@index([status])
}

enum AffiliateCommissionStatus {
  CREDITED
  REVERSED
}

/// Explicit platform registry. Owners are existing local accounts.
// Delivery companies reserve a platform before their first owner exists.
// Only the completed Platform participates in authorization and financial operations.
model DeliveryPlatformRegistration {
  id                 String @id @default(uuid())
  integrationKey     String @unique
  externalMerchantId String @unique
  name               String
  platformId         String?
  platform           Platform? @relation(fields: [platformId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([platformId])
}

enum PlatformFeeMode {
  SIMINTPAY_ONLY
  ADDITIVE_ONLY
  BOTH
}

model Platform {
  id             String @id @default(uuid())
  tag            String @unique
  name           String
  ownerUserId    String
  isActive       Boolean @default(true)
  acquirer       Acquirer @default(DOM)
  users          User[] @relation("PlatformMembers")
  customerInterestRates Json @default("{}")
  absorbCustomerInterest Boolean @default(true)
  /// Which fee sets apply to platform payments. SIMINTPAY_ONLY is the default.
  feeMode PlatformFeeMode @default(SIMINTPAY_ONLY)
  /// Target fee in millionths of the purchase total. Set: the seller is charged this share (highest acquirer cost plus a SimIntPay addition) and manual fees/fee mode are ignored but kept.
  targetFeePpm Int?
  /// `METHOD/installments` lanes the platform does not accept; ignored by fee listing and coverage.
  disabledPaymentLanes String[] @default([])
  integrations   PlatformIntegration[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User @relation("PlatformOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId])
  delegatedCredentials PlatformApiCredential[]
  deliveryRegistrations DeliveryPlatformRegistration[]
  salesEvents PlatformSalesEvent[]
  additiveFees PlatformAdditiveFees?
}

/// Private integration configuration; encrypted values never appear in public metadata.
model PlatformIntegration {
  id             String @id @default(uuid())
  platformId     String
  key            String
  encryptedValue String?
  tokenHash      String? @unique
  url            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  platform       Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, key])
}

model PushSubscription {
  id String @id
  userId String
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now()) @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@index([userId])
}
model SalePushEvent {
  id String @id
  transactionId String
  userId String
  amount Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@unique([transactionId, userId])
}
model PushDelivery {
  id String @id
  eventId String
  subscriptionId String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz
  error String?
  event SalePushEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([eventId, subscriptionId])
  @@index([status, nextAttemptAt])
}
model SalePushActivation {
  startedAt DateTime @id @default(now()) @db.Timestamptz
}

/// Signed, replayable sales callbacks. Payload excludes buyer document/card data.
model PlatformSalesEvent {
  sequence BigInt @id @default(autoincrement())
  eventId String @unique
  platformId String
  platform Platform @relation(fields: [platformId], references: [id])
  url String
  payload Json
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  emailDeliveredAt DateTime?
  deliveredAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([platformId, sequence])
  @@index([deliveredAt, nextAttemptAt])
}

/// Append-only policy revisions. No legacy prices are interpreted as acquirer interest.
model FinancialPolicyRevision {
  id String @id @default(uuid())
  tag String
  version Int
  document Json
  actorId String
  createdAt DateTime @default(now())
  @@unique([tag, version])
}

/// Technical catalogue; policy keys and historical revisions retain their original codes.
model AcquirerCatalogue {
  code String @id
  name String
  active Boolean @default(true)
  syncAdapter String?
  feeSchedules AcquirerFeeSchedule[]
  withdrawalFees AcquirerWithdrawalFee[]
  withdrawals AcquirerWithdrawal[]
  externalRefs ExternalRef[]
  storedCardTokens StoredCardToken[]
}

/// Append-only per-acquirer withdrawal cost in cents. The latest row per acquirer wins.
model AcquirerWithdrawalFee {
  id String @id @default(uuid())
  acquirerCode String
  acquirer AcquirerCatalogue @relation(fields: [acquirerCode], references: [code], onDelete: Restrict)
  feeCents Int
  source String
  actorId String?
  createdAt DateTime @default(now())
  @@index([acquirerCode, createdAt], map: "acquirer_withdrawal_fee_created_idx")
}

/// Withdrawal made from an acquirer on a given day. Each row has a matching ADMIN_WITHDRAW_FEE_INC
/// BalanceLog (balanceLogId) carrying the cost into the financial reports.
model AcquirerWithdrawal {
  id String @id @default(uuid())
  acquirerCode String
  acquirer AcquirerCatalogue @relation(fields: [acquirerCode], references: [code], onDelete: Restrict)
  feeCents Int
  /// Amount withdrawn in cents; optional for manual entries.
  amountCents Int?
  date DateTime @db.Date
  balanceLogId String? @unique
  actorId String?
  /// MANUAL (admin) or SYNC (imported from the acquirer).
  source String @default("MANUAL")
  /// Acquirer-side transfer id; makes the sync idempotent.
  externalId String?
  createdAt DateTime @default(now())
  @@unique([acquirerCode, externalId])
  @@index([date])
}

/// Cashback avulso (DOM Vale Bônus) concedido a compras aprovadas em outras adquirentes.
/// Uma linha por transação (idempotente); o envio à DOM acontece fora da transação de liquidação.
model CashbackGrant {
  id String @id @default(uuid())
  transactionId String @unique
  valueCents Int
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
}

/// Append-only negotiated costs. A newer revision supersedes older rows for the same lane.
model AcquirerFeeSchedule {
  id String @id @default(uuid())
  acquirerCode String
  acquirer AcquirerCatalogue @relation(fields: [acquirerCode], references: [code], onDelete: Restrict)
  method String
  channel String
  installments Int
  fixedCents Int
  ratePpm Int
  interestPpm Int
  base String @default("BUYER_TOTAL")
  source String
  actorId String?
  changeDirection String @default("INITIAL")
  createdAt DateTime @default(now())
  @@index([acquirerCode, method, channel, installments, createdAt], map: "acquirer_fee_lane_created_idx")
}


/// Private product agreements, updated with an optimistic version check.
model CoproductionAgreement {
  mode String @default("OWN")
  actor User @relation("CoproductionAgreementActor", fields: [actorId], references: [id], onDelete: Restrict)
  product String
  productId String
  version Int
  participants Json
  actorId String
  updatedAt DateTime @default(now())
  @@id([product, productId])
}

/// Immutable audit of accepted agreement versions.
model CoproductionRevision {
  mode String @default("OWN")
  actor User @relation("CoproductionRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)
  product String
  productId String
  version Int
  participants Json
  actorId String
  createdAt DateTime @default(now())
  @@id([product, productId, version])
}

/// Exact original settlement amounts; reversals never recalculate percentages.
model CoproductionAllocation {
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactionId String
  userId String
  amount Decimal @db.Decimal(12, 2)
  state String
  createdAt DateTime @default(now())
  @@id([transactionId, userId])
  @@index([userId])
}

// Explicit shared acquiring account, never a fallback to another platform.
model PaymentIntegrationProfile {
  id String @id @default(uuid())
  code String @unique
  acquirer Acquirer @default(DOM)
  encryptedCredential String
  isActive Boolean @default(true)
  credentials PlatformApiCredential[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformApiCredential {
  id String @id @default(uuid())
  source String @default("delivery")
  externalCompanyId String @unique
  platformId String
  platform Platform @relation(fields: [platformId], references: [id], onDelete: Restrict)
  merchantId String
  profileId String
  profile PaymentIntegrationProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  tokenHash String @unique
  encryptedToken String
  encryptedWebhookSecret String
  operations String[]
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cardCustomers CanonicalCardCustomer[]
  events CanonicalMerchantEvent[]
  @@index([platformId, merchantId])
}

model CanonicalCardCustomer {
  id String @id @default(uuid())
  credentialId String
  credential PlatformApiCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  externalCustomerId String
  providerCustomerId String
  @@unique([credentialId, externalCustomerId])
}

model CanonicalMerchantEvent {
  id String @id @default(uuid())
  credentialId String
  credential PlatformApiCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  eventId String @unique
  payload Json
  deliveredAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  @@index([deliveredAt, nextAttemptAt])
}

/// Immutable audit of product owner reassignments. History (transactions, snapshots, ledger) is never rewritten.
model ProductOwnershipChange {
  id          String   @id @default(uuid())
  productType String
  productId   String
  fromUserId  String
  toUserId    String
  /// 'SCRIPT' or the administrator user id that applied the change.
  actor       String
  reason      String
  mappingHash String
  createdAt   DateTime @default(now())
  fromUser    User     @relation("ProductOwnershipFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser      User     @relation("ProductOwnershipTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([productType, productId])
}

/// Generic platform surcharge totals. Percentages in basis points; fixed values in cents.
model PlatformAdditiveFees {
  platformId String @id
  orderPct Int @default(0)
  orderFixed Int @default(0)
  productPct Int @default(0)
  productFixed Int @default(0)
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
}


/// Neutral link between an acquirer-side identifier and the internal entity it represents.
/// New code must resolve gateway IDs here instead of adding `dom*` columns, so swapping
/// acquirers never requires touching the owning tables.
model ExternalRef {
  id String @id @default(uuid())
  acquirerCode String
  acquirer AcquirerCatalogue @relation(fields: [acquirerCode], references: [code], onDelete: Restrict)
  /// PLAN | SUBSCRIPTION | PAYMENT_LINK | PAYMENT | CUSTOMER | CARD_TOKEN
  kind String
  externalId String
  /// Internal model name (Offer, BillingContract, Charge, ...).
  entityType String
  entityId String
  createdAt DateTime @default(now())
  @@unique([acquirerCode, kind, externalId])
  @@unique([entityType, entityId, acquirerCode, kind])
  @@index([entityType, entityId])
}


/// What is sold: price, accepted methods, validity and recurrence. Acquirer-agnostic;
/// the former link, plan and boleto products are presets of this model.
model Offer {
  id              String              @id @default(uuid())
  /// Financial owner (seller); never the admin who created it.
  ownerUserId     String
  createdByUserId String
  owner           User                @relation("OfferOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  platformTag     String?
  code            String              @unique
  name            String
  description     String?
  amountCents     Int
  currency        String              @default("BRL") @db.VarChar(3)
  isActive        Boolean             @default(true)
  acceptedMethods PaymentMethod[]
  maxInstallments Int                 @default(1)
  /// When the offer stops being sellable.
  expiresAt       DateTime?
  maxUses         Int?
  usedCount       Int                 @default(0)
  renewalMode     RenewalMode         @default(NONE)
  intervalType    BillingIntervalType?
  intervalCount   Int?
  /// Total cycles; null or 0 means until cancelled.
  repetitions     Int?
  trialDays       Int?
  retryDays       Int?
  graceDays       Int?
  fulfillment     Json?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  contracts       BillingContract[]
  charges         Charge[]
  transactions    Transaction[]
  accesses        OfferAccess[]
  codeAliases     OfferCodeAlias[]

  @@index([ownerUserId])
}

/// One amount owed by a payer: a standalone sale or a single cycle of a contract.
/// Distinct from the reporting projection `Cobranca`.
model Charge {
  id               String           @id @default(uuid())
  offerId          String?
  contractId       String?
  ownerUserId      String
  amountCents      Int
  currency         String           @default("BRL") @db.VarChar(3)
  status           ChargeStatus     @default(PENDING)
  method           PaymentMethod?
  dueAt            DateTime?
  periodStart      DateTime?
  periodEnd        DateTime?
  /// Idempotency of a cycle: the contract period end it bills for.
  cycleKey         String?
  attempts         Int              @default(0)
  customerName     String?
  customerEmail    String?
  customerDocument String?
  transactionId    String?          @unique
  /// Frozen fee, coproduction and owner data at issue time.
  snapshot         Json?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  offer            Offer?           @relation(fields: [offerId], references: [id], onDelete: Restrict)
  contract         BillingContract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  transaction      Transaction?     @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([contractId, cycleKey])
  @@index([offerId])
  @@index([ownerUserId, status])
  @@index([status, dueAt])
}


/// Days of access credited to a buyer by paid charges of a recurring offer, one renewal interval per charge
/// (port of the legacy PIX credit plan access). `expiresAt` is the source of truth.
model OfferAccess {
  id                String    @id @default(uuid())
  offerId           String
  ownerUserId       String
  /// Customer row of the seller (plain id, no FK: the legacy Customer table is being retired).
  customerId        String?
  customerEmail     String
  customerDocument  String
  customerName      String?
  isActive          Boolean   @default(false)
  expiresAt         DateTime
  /// Remaining days kept while the access is suspended; 0 otherwise.
  frozenDays        Int       @default(0)
  /// Cumulative days ever credited.
  totalDaysCredited Int       @default(0)
  lastChargeId      String?
  lastTransactionId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  offer             Offer     @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@unique([offerId, customerDocument])
  @@unique([offerId, customerId])
  @@index([offerId])
  @@index([ownerUserId, isActive])
  @@index([customerEmail])
  @@index([isActive, expiresAt])
}

/// Idempotent, auditable events of an OfferAccess: `credit:<chargeId>` (a charge credits once)
/// and `reminder:<accessId>:<expiresAt>:<offset>` (an expiry e-mail is sent once).
model OfferAccessEvent {
  id          String   @id @default(uuid())
  accessId    String
  eventKey    String   @unique @db.VarChar(191)
  type        String   @db.VarChar(40)
  payload     Json
  deliveredAt DateTime?
  attempts    Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())

  @@index([accessId, type])
}

/// Extra public codes of an offer (e.g. `PX-ABC123` from the legacy PIX plan link code).
/// `Offer.code` stays the primary code.
model OfferCodeAlias {
  id        String   @id @default(uuid())
  code      String   @unique
  offerId   String
  /// Origin of the code, e.g. `PX` for the legacy PixPlanLinkCode.
  kind      String   @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@index([offerId, isActive])
}

enum StoredCardStatus {
  ACTIVE
  REVOKED
}

/// Card vault entry owned by SimIntPay. Never holds PAN or CVV: only display metadata
/// plus acquirer-issued reusable tokens (StoredCardToken), so AUTO_CHARGE can run without the buyer.
model StoredCard {
  id            String           @id @default(uuid())
  ownerUserId   String
  contractId    String?
  customerEmail String
  brand         String?          @db.VarChar(30)
  last4         String           @db.VarChar(4)
  expMonth      Int
  expYear       Int
  status        StoredCardStatus @default(ACTIVE)
  revokedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  contract      BillingContract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  tokens        StoredCardToken[]

  @@index([ownerUserId])
  @@index([contractId, status])
}

/// Reusable card token issued by one acquirer, encrypted with PLATFORM_CONFIG_ENCRYPTION_KEY.
model StoredCardToken {
  id             String            @id @default(uuid())
  storedCardId   String
  acquirerCode   String
  encryptedToken String
  /// Customer (wallet) at the acquirer the token is bound to; null for tokens not tied to a wallet.
  acquirerCustomerId String?
  createdAt      DateTime          @default(now())
  storedCard     StoredCard        @relation(fields: [storedCardId], references: [id], onDelete: Cascade)
  acquirer       AcquirerCatalogue @relation(fields: [acquirerCode], references: [code], onDelete: Restrict)

  @@unique([storedCardId, acquirerCode])
}
