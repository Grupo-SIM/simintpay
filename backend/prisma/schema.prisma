// ── External Platform Users (donos de plataformas externas, ex: ebook) ────────
// Representa usuários identificados via CPF ou CNPJ nas descrições de transações.
// Quando o usuário se cadastra na Simpay com o mesmo documento, é feita a vinculação.
model ExternalPlatformUser {
  id          String                   @id @default(uuid())
  cpf         String?
  cnpj        String?
  name        String
  platform    String                   // slug da plataforma ex: "ebook"
  userId      String?                  // vinculado ao User da Simpay quando se cadastra
  isDeleted   Boolean                  @default(false)  // inativado (reversível)
  deletedAt   DateTime?
  // Exclusão permanente (irreversível): estado final, o saldo foi absorvido pelo master.
  // Não apagamos a linha — apagar mudaria o histórico/relatórios retroativamente.
  isPurged    Boolean                  @default(false)
  purgedAt    DateTime?
  purgedAmount Decimal?                @db.Decimal(12, 2)  // saldo absorvido no momento da exclusão
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  wallet      ExternalPlatformWallet?
  user        User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([cpf, platform])
  @@unique([cnpj, platform])
  @@index([cpf])
  @@index([cnpj])
  @@index([platform])
  @@index([userId])
}

model ExternalPlatformWallet {
  id                   String               @id @default(uuid())
  externalUserId       String               @unique
  balance              Decimal              @default(0) @db.Decimal(12, 2)
  lockedBalance        Decimal              @default(0) @db.Decimal(12, 2)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  externalUser         ExternalPlatformUser @relation(fields: [externalUserId], references: [id])
}

// ── PIX Credit Plan (crédito de dias via PIX) ─────────────────────────────

model PixCreditPlan {
  /// Executor only; userId remains the financial beneficiary. Null for unaudited legacy rows.
  createdByUserId String?
  id          String               @id @default(uuid())
  userId      String
  type        PlanType
  price       Float
  description String?
  redirectUrl String?
  webhookUrl  String?
  status      String               @default("ACTIVE")
  /// Corpo de e-mail personalizado enviado ao comprador (apenas itens de ebook)
  emailBody   String?
  /// Tag da plataforma vinculada (ex: PAGATG, AREAFLIX, RENOVADA)
  tenantTag   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkCodes   PixPlanLinkCode[]
  orders      PixPlanOrder[]
  accesses    CustomerPlanAccess[]

  @@index([userId])
  @@index([status])
  @@index([tenantTag])
}

model PixPlanLinkCode {
  id              String        @id @default(uuid())
  code            String        @unique
  pixCreditPlanId String
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pixCreditPlan   PixCreditPlan @relation(fields: [pixCreditPlanId], references: [id])

  @@index([pixCreditPlanId])
  @@index([isActive])
}

model PixPlanOrder {
  id               String         @id @default(uuid())
  transactionId    String         @unique
  userId           String
  customerId       String?
  customerEmail    String
  customerDocument String
  planType         PlanType
  daysCredited     Int
  pixCreditPlanId  String?
  paid             Boolean        @default(false)
  creditedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  transaction      Transaction    @relation(fields: [transactionId], references: [id])
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer         Customer?      @relation(fields: [customerId], references: [id])
  pixCreditPlan    PixCreditPlan? @relation(fields: [pixCreditPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerDocument])
  @@index([customerId])
  @@index([pixCreditPlanId])
}

model CustomerPlanAccess {
  id                String         @id @default(uuid())
  userId            String
  customerId        String
  pixPlanId         String?
  pixPlanCode       String?
  customerEmail     String
  customerDocument  String
  isActive          Boolean        @default(false)
  expiresAt         DateTime
  totalDaysCredited Int            @default(0)
  lastTransactionId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer          Customer       @relation(fields: [customerId], references: [id])
  pixPlan           PixCreditPlan? @relation(fields: [pixPlanId], references: [id], onDelete: SetNull)

  @@unique([userId, customerDocument, pixPlanId])
  @@unique([userId, customerId, pixPlanId])
  @@index([userId])
  @@index([customerEmail])
  @@index([pixPlanId])
}

model PlatformTaxaOverride {
  id        String   @id @default(uuid())
  tag       String
  key       String
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tag, key])
  @@index([tag])
}

// Acesso por assinatura para plataformas SaaS (CONTROLE-MOTORISTA, CONTROLE-PATRIMONIAL)
model PlatformSubscriberAccess {
  id                String   @id @default(uuid())
  platformTag       String   // "CONTROLE-MOTORISTA" | "CONTROLE-PATRIMONIAL"
  customerEmail     String
  customerName      String?
  customerCpf       String?
  customerPhone     String?
  isActive          Boolean  @default(true)
  expiresAt         DateTime
  frozenDays        Int      @default(0)  // Dias guardados ao pausar
  totalDaysCredited Int      @default(0)  // Acumulado histórico de dias creditados
  lastTransactionId String?
  lastPaymentMethod String?               // "PIX" | "CREDIT_CARD" — método do último pagamento
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([platformTag, customerEmail])
  @@index([platformTag])
  @@index([customerEmail])
}

// ── Vouchers ──────────────────────────────────────────────────────────────────

model Voucher {
  id               String         @id @default(uuid())
  userId           String
  code             String
  description      String?
  discountType     DiscountType
  discountValue    Float
  maxUsage         Int?
  maxDiscountValue Float?
  validFrom        DateTime?
  validUntil       DateTime?
  applicablePlans  String[]
  minOrderValue    Float?
  allowedChannels  String[]       @default(["PAGATG"])
  allowedLinkCodes String[]       @default([])
  isActive         Boolean        @default(true)
  usageCount       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages           VoucherUsage[]

  @@unique([code])
  @@index([userId])
  @@index([code])
}

model VoucherUsage {
  id               String   @id @default(uuid())
  voucherId        String
  transactionId    String?
  subscriptionId   String?
  customerEmail    String
  customerDocument String
  originalAmount   Float
  discountAmount   Float
  finalAmount      Float
  createdAt        DateTime @default(now())
  voucher          Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ── Programa de Afiliados ───────────────────────────────────────────────────

model AffiliateCommission {
  id               String                    @id @default(uuid())
  affiliateUserId  String
  referredUserId   String
  transactionId    String                    @unique
  percentApplied   Decimal                   @db.Decimal(5, 2)
  grossPlatformFee Decimal                   @db.Decimal(12, 2)
  commissionAmount Decimal                   @db.Decimal(12, 2)
  status           AffiliateCommissionStatus @default(CREDITED)
  createdAt        DateTime                  @default(now())
  reversedAt       DateTime?
  affiliate        User                      @relation("AffiliateCommissionsEarned", fields: [affiliateUserId], references: [id])
  referredUser     User                      @relation("AffiliateCommissionsGenerated", fields: [referredUserId], references: [id])

  @@index([affiliateUserId])
  @@index([referredUserId])
  @@index([status])
}

enum AffiliateCommissionStatus {
  CREDITED
  REVERSED
}

/// Explicit platform registry. Owners are existing local accounts.
// Delivery companies reserve a platform before their first owner exists.
// Only the completed Platform participates in authorization and financial operations.
model DeliveryPlatformRegistration {
  id                 String @id @default(uuid())
  integrationKey     String @unique
  externalMerchantId String @unique
  name               String
  platformId         String?
  platform           Platform? @relation(fields: [platformId], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([platformId])
}

model Platform {
  id             String @id @default(uuid())
  tag            String @unique
  name           String
  ownerUserId    String
  isActive       Boolean @default(true)
  acquirer       Acquirer @default(DOM)
  users          User[] @relation("PlatformMembers")
  customerInterestRates Json @default("{}")
  absorbCustomerInterest Boolean @default(true)
  integrations   PlatformIntegration[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User @relation("PlatformOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  @@index([ownerUserId])
  delegatedCredentials PlatformApiCredential[]
  deliveryRegistrations DeliveryPlatformRegistration[]
  salesEvents PlatformSalesEvent[]
}

/// Private integration configuration; encrypted values never appear in public metadata.
model PlatformIntegration {
  id             String @id @default(uuid())
  platformId     String
  key            String
  encryptedValue String?
  tokenHash      String? @unique
  url            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  platform       Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@unique([platformId, key])
}

model PushSubscription {
  id String @id
  userId String
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now()) @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@index([userId])
}
model SalePushEvent {
  id String @id
  transactionId String
  userId String
  amount Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries PushDelivery[]
  @@unique([transactionId, userId])
}
model PushDelivery {
  id String @id
  eventId String
  subscriptionId String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @db.Timestamptz
  error String?
  event SalePushEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subscription PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([eventId, subscriptionId])
  @@index([status, nextAttemptAt])
}
model SalePushActivation {
  startedAt DateTime @id @default(now()) @db.Timestamptz
}

/// Signed, replayable sales callbacks. Payload excludes buyer document/card data.
model PlatformSalesEvent {
  sequence BigInt @id @default(autoincrement())
  eventId String @unique
  platformId String
  platform Platform @relation(fields: [platformId], references: [id])
  url String
  payload Json
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  emailDeliveredAt DateTime?
  deliveredAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([platformId, sequence])
  @@index([deliveredAt, nextAttemptAt])
}

/// Append-only policy revisions. No legacy prices are interpreted as acquirer interest.
model FinancialPolicyRevision {
  id String @id @default(uuid())
  tag String
  version Int
  document Json
  actorId String
  createdAt DateTime @default(now())
  @@unique([tag, version])
}

/// Technical catalogue; policy keys and historical revisions retain their original codes.
model AcquirerCatalogue {
  code String @id
  name String
  active Boolean @default(true)
  syncAdapter String?
  feeSchedules AcquirerFeeSchedule[]
}

/// Append-only negotiated costs. A newer revision supersedes older rows for the same lane.
model AcquirerFeeSchedule {
  id String @id @default(uuid())
  acquirerCode String
  acquirer AcquirerCatalogue @relation(fields: [acquirerCode], references: [code], onDelete: Restrict)
  method String
  channel String
  installments Int
  fixedCents Int
  ratePpm Int
  interestPpm Int
  base String @default("BUYER_TOTAL")
  source String
  actorId String?
  changeDirection String @default("INITIAL")
  createdAt DateTime @default(now())
  @@index([acquirerCode, method, channel, installments, createdAt], map: "acquirer_fee_lane_created_idx")
}


/// Private product agreements, updated with an optimistic version check.
model CoproductionAgreement {
  mode String @default("OWN")
  actor User @relation("CoproductionAgreementActor", fields: [actorId], references: [id], onDelete: Restrict)
  product String
  productId String
  version Int
  participants Json
  actorId String
  updatedAt DateTime @default(now())
  @@id([product, productId])
}

/// Immutable audit of accepted agreement versions.
model CoproductionRevision {
  mode String @default("OWN")
  actor User @relation("CoproductionRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)
  product String
  productId String
  version Int
  participants Json
  actorId String
  createdAt DateTime @default(now())
  @@id([product, productId, version])
}

/// Exact original settlement amounts; reversals never recalculate percentages.
model CoproductionAllocation {
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactionId String
  userId String
  amount Decimal @db.Decimal(12, 2)
  state String
  createdAt DateTime @default(now())
  @@id([transactionId, userId])
  @@index([userId])
}

// Explicit shared acquiring account, never a fallback to another platform.
model PaymentIntegrationProfile {
  id String @id @default(uuid())
  code String @unique
  acquirer Acquirer @default(DOM)
  encryptedCredential String
  isActive Boolean @default(true)
  credentials PlatformApiCredential[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformApiCredential {
  id String @id @default(uuid())
  source String @default("delivery")
  externalCompanyId String @unique
  platformId String
  platform Platform @relation(fields: [platformId], references: [id], onDelete: Restrict)
  merchantId String
  profileId String
  profile PaymentIntegrationProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  tokenHash String @unique
  encryptedToken String
  encryptedWebhookSecret String
  operations String[]
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cardCustomers CanonicalCardCustomer[]
  events CanonicalMerchantEvent[]
  @@index([platformId, merchantId])
}

model CanonicalCardCustomer {
  id String @id @default(uuid())
  credentialId String
  credential PlatformApiCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  externalCustomerId String
  providerCustomerId String
  @@unique([credentialId, externalCustomerId])
}

model CanonicalMerchantEvent {
  id String @id @default(uuid())
  credentialId String
  credential PlatformApiCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  eventId String @unique
  payload Json
  deliveredAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  @@index([deliveredAt, nextAttemptAt])
}

/// Immutable audit of product owner reassignments. History (transactions, snapshots, ledger) is never rewritten.
model ProductOwnershipChange {
  id          String   @id @default(uuid())
  productType String
  productId   String
  fromUserId  String
  toUserId    String
  /// 'SCRIPT' or the administrator user id that applied the change.
  actor       String
  reason      String
  mappingHash String
  createdAt   DateTime @default(now())
  fromUser    User     @relation("ProductOwnershipFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser      User     @relation("ProductOwnershipTo", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([productType, productId])
}
