# Comma-separated hostnames allowed to access Next.js development resources.
ALLOWED_DEV_ORIGINS=frontend.hyoretsu.com

# Next.js embeds NEXT_PUBLIC_* variables during build.
NEXT_PUBLIC_SIM_API_URL=http://localhost:3333
NEXT_PUBLIC_API_PAGATG_URL=https://api-bot.jbmidia.com
NEXT_PUBLIC_EBOOK_API_URL=https://back.ebooksim.com

# Runtime flag (server). Off by default: legacy URLs (simLinkCode, subscriptionLinkCode,
# simBoletoCode, simPlanCode, linkCode, subscriptionCode) keep using the legacy checkouts.
# Set to true only after the products were migrated to Offers (plan 0023, phase 2): the legacy
# params are then redirected (307) to ?oferta=<same value>, resolved by code, then by id.
CHECKOUT_LEGACY_TO_OFFER=false
