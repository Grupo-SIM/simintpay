{
  "extends": ["//"],
  "tasks": {
    "dev": {
      "dependsOn": ["^export"],
      "with": ["backend#dev"],
      "passThroughEnv": ["*"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^export"],
      "env": [
        "NEXT_PUBLIC_SIM_API_URL",
        "NEXT_PUBLIC_API_PAGATG_URL",
        "NEXT_PUBLIC_EBOOK_API_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
