{
	"$schema": "https://turborepo.dev/schema.json",
	"globalPassThroughEnv": ["DATABASE_URL"],
	"tasks": {
		"build": {
			"dependsOn": ["^build", "generate"],
			"env": [
				"NEXT_PUBLIC_API_BASE_URL",
				"NEXT_PUBLIC_BACKEND_URL",
				"NEXT_PUBLIC_CHECKOUT_BASE_URL",
				"NEXT_PUBLIC_CLIENT_MIN_AMOUNT",
				"NEXT_PUBLIC_RECAPTCHA_SITE_KEY"
			],
			"outputLogs": "new-only",
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"check-types": {
			"cache": false,
			"dependsOn": ["^check-types", "generate"],
			"outputLogs": "new-only"
		},
		"dev": {
			"cache": false,
			"dependsOn": ["generate"],
			"passThroughEnv": ["*"],
			"persistent": true
		},
		"export": {
			"cache": false,
			"dependsOn": ["generate"],
			"outputLogs": "new-only",
			"outputs": ["out/openapi.json"]
		},
		"generate": {
			"inputs": ["prisma/schema.prisma", "prisma.config.ts"],
			"outputLogs": "new-only",
			"outputs": ["../node_modules/.prisma/client/**"]
		},
		"lint": {
			"cache": false
		},
		"migrate:deploy": {
			"cache": false,
			"env": ["DATABASE_URL"],
			"inputs": ["prisma/migrations/**"]
		},
		"start": {
			"cache": false,
			"passThroughEnv": ["*"],
			"persistent": true
		},
		"test:e2e": {
			"cache": false
		},
		"test:unit": {
			"cache": false,
			"dependsOn": ["generate"]
		}
	}
}
