# Public values are embedded by Next at build time. Use local services for development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3333
NEXT_PUBLIC_CHECKOUT_BASE_URL=http://localhost:3000
NEXT_PUBLIC_CLIENT_MIN_AMOUNT=14.99
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Server-only runtime SMTP configuration; never use NEXT_PUBLIC_ for credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
