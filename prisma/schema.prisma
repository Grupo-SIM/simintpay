generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(uuid())
  name                 String
  email                String               @unique
  password             String
  role                 Role                 @default(USER)
  isActive             Boolean              @default(true)
  domUserId            String?              @unique
  domToken             String?
  tenantModuleId       String?
  cpf                  String?              @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  balanceLogs          BalanceLog[]
  customers            Customer[]
  paymentLinks         PaymentLink[]
  plans                Plan[]
  sessions             Session[]
  subscriptions        Subscription[]
  transactions         Transaction[]
  wallet               Wallet?
  withdrawals          WithdrawRequest[]
  tenantModule         TenantModule?        @relation(fields: [tenantModuleId], references: [id])
  pixCreditPlans       PixCreditPlan[]
  pixPlanOrders        PixPlanOrder[]
  customerPlanAccesses CustomerPlanAccess[]

  @@index([email])
  @@index([domUserId])
  @@index([tenantModuleId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model Wallet {
  id            String   @id @default(uuid())
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  lockedBalance Decimal  @default(0) @db.Decimal(12, 2)
  version       Int      @default(0)
  userId        String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model BalanceLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  transactionId String?
  amount        Decimal  @db.Decimal(12, 2)
  balanceBefore Decimal  @db.Decimal(12, 2)
  balanceAfter  Decimal  @db.Decimal(12, 2)
  lockedBefore  Decimal  @db.Decimal(12, 2)
  lockedAfter   Decimal  @db.Decimal(12, 2)
  description   String?
  source        String
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@index([createdAt])
}

model Transaction {
  id               String                     @id @default(uuid())
  userId           String
  amount           Decimal                    @db.Decimal(12, 2)
  netAmount        Decimal?                   @db.Decimal(12, 2)
  status           TransactionStatus          @default(DRAFT)
  previousStatus   TransactionStatus?
  paymentMethod    PaymentMethod              @default(PIX)
  description      String?
  installments     Int                        @default(1)
  totalFee         Decimal                    @default(0) @db.Decimal(12, 2)
  domFee           Decimal                    @default(0) @db.Decimal(12, 2)
  platformFee      Decimal                    @default(0) @db.Decimal(12, 2)
  domTransactionId String?                    @unique
  domPaymentId     String?                    @unique
  pixQrCode        String?
  pixContent       String?
  pixExpire        DateTime?
  cardBrand        String?
  cardBin          String?
  cardCodeAuth     String?
  customerName     String?
  customerEmail    String?
  customerDocument String?
  customerPhone    String?
  paymentLinkId    String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  paymentLink      PaymentLink?               @relation(fields: [paymentLinkId], references: [id])
  user             User                       @relation(fields: [userId], references: [id])
  statusHistory    TransactionStatusHistory[]
  pixPlanOrder     PixPlanOrder?

  @@index([userId])
  @@index([status])
  @@index([domPaymentId])
  @@index([createdAt])
  @@index([paymentMethod])
}

model TransactionStatusHistory {
  id            String            @id @default(uuid())
  transactionId String
  fromStatus    TransactionStatus
  toStatus      TransactionStatus
  metadata      Json?
  createdAt     DateTime          @default(now())
  transaction   Transaction       @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

model WithdrawRequest {
  id              String         @id @default(uuid())
  userId          String
  amount          Decimal        @db.Decimal(12, 2)
  grossAmount     Decimal        @db.Decimal(12, 2)
  fee             Decimal        @default(2.00) @db.Decimal(12, 2)
  status          WithdrawStatus @default(PENDING)
  pixKey          String
  receiptImage    String?
  rejectionReason String?
  domWithdrawId   String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PaymentLink {
  id               String        @id @default(uuid())
  userId           String
  code             String        @unique @default(uuid())
  title            String
  description      String?
  amount           Decimal       @db.Decimal(12, 2)
  expiresAt        DateTime?
  maxInstallments  Int           @default(1)
  aceitaCartao     Boolean       @default(true)
  aceitaPix        Boolean       @default(true)
  isActive         Boolean       @default(true)
  domPaymentLinkId String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])
  transactions     Transaction[]

  @@index([userId])
  @@index([code])
}

model Plan {
  id            String         @id @default(uuid())
  userId        String
  name          String
  description   String?
  price         Decimal        @db.Decimal(12, 2)
  type          PlanType
  isActive      Boolean        @default(true)
  webhookUrl    String?
  redirectUrl   String?
  domPlanId     String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  subscriptions Subscription[]

  @@index([userId])
}

model Subscription {
  id                String    @id @default(uuid())
  userId            String
  planId            String
  customerId        String?
  status            String    @default("active")
  expiresAt         DateTime?
  totalDaysCredited Int       @default(0)
  domSubscriptionId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  customer          Customer? @relation(fields: [customerId], references: [id])
  plan              Plan      @relation(fields: [planId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
}

model Customer {
  id                   String               @id @default(uuid())
  userId               String
  name                 String
  email                String
  document             String
  documentType         String               @default("CPF")
  phone                String?
  domCustomerId        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id])
  subscriptions        Subscription[]
  pixPlanOrders        PixPlanOrder[]
  customerPlanAccesses CustomerPlanAccess[]

  @@unique([userId, document])
  @@index([email])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  source      String
  eventType   String
  payload     Json
  status      String    @default("PENDING")
  retryCount  Int       @default(0)
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([status])
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  webhookUrl         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TenantModule {
  id        String   @id @default(uuid())
  name      String // Ex: "Revalida", "Renovada"
  slug      String   @unique // Ex: "revalida", "renovada" — usado p/ env var {SLUG}_DOM_TOKEN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@index([slug])
}

model Lead {
  id              String     @id @default(uuid())
  name            String
  phone           String
  email           String
  razaoSocial     String
  cnpj            String
  cpf             String?
  faturamento     String
  tempoOperacao   String
  modeloOperacao  String?
  cargo           String
  comoConheceu    String?
  status          LeadStatus @default(PENDING)
  rejectionReason String?
  approvedUserId  String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([email])
  @@index([cnpj])
}

enum Role {
  USER
  ADMIN
}

enum TransactionStatus {
  DRAFT
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  EXPIRED
  IN_MEDIATION
  CHARGEBACK
  PENDING_REFUND
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum WithdrawStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

enum PlanType {
  MONTHLY
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum LeadStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── PIX Credit Plan (crédito de dias via PIX) ─────────────────────────────

model PixCreditPlan {
  id          String               @id @default(uuid())
  userId      String
  type        PlanType
  price       Float
  description String?
  redirectUrl String?
  webhookUrl  String?
  status      String               @default("ACTIVE")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkCodes   PixPlanLinkCode[]
  orders      PixPlanOrder[]
  accesses    CustomerPlanAccess[]

  @@index([userId])
  @@index([status])
}

model PixPlanLinkCode {
  id              String        @id @default(uuid())
  code            String        @unique
  pixCreditPlanId String
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pixCreditPlan   PixCreditPlan @relation(fields: [pixCreditPlanId], references: [id])

  @@index([pixCreditPlanId])
  @@index([isActive])
}

model PixPlanOrder {
  id               String         @id @default(uuid())
  transactionId    String         @unique
  userId           String
  customerId       String?
  customerEmail    String
  customerDocument String
  planType         PlanType
  daysCredited     Int
  pixCreditPlanId  String?
  paid             Boolean        @default(false)
  creditedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  transaction      Transaction    @relation(fields: [transactionId], references: [id])
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer         Customer?      @relation(fields: [customerId], references: [id])
  pixCreditPlan    PixCreditPlan? @relation(fields: [pixCreditPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerDocument])
  @@index([customerId])
  @@index([pixCreditPlanId])
}

model CustomerPlanAccess {
  id                String         @id @default(uuid())
  userId            String
  customerId        String
  pixPlanId         String?
  pixPlanCode       String?
  customerEmail     String
  customerDocument  String
  isActive          Boolean        @default(false)
  expiresAt         DateTime
  totalDaysCredited Int            @default(0)
  lastTransactionId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer          Customer       @relation(fields: [customerId], references: [id])
  pixPlan           PixCreditPlan? @relation(fields: [pixPlanId], references: [id], onDelete: SetNull)

  @@unique([userId, customerDocument, pixPlanId])
  @@unique([userId, customerId, pixPlanId])
  @@index([userId])
  @@index([customerEmail])
  @@index([pixPlanId])
}
