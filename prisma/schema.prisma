generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(uuid())
  name                 String
  email                String               @unique
  password             String
  role                 Role                 @default(USER)
  isActive             Boolean              @default(true)
  domUserId            String?              @unique
  domToken             String?
  tenantModuleId       String?
  cpf                  String?              @unique
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  balanceLogs          BalanceLog[]
  customers            Customer[]
  paymentLinks         PaymentLink[]
  plans                Plan[]
  sessions             Session[]
  subscriptions        Subscription[]
  transactions         Transaction[]
  wallet               Wallet?
  withdrawals          WithdrawRequest[]
  tenantModule         TenantModule?        @relation(fields: [tenantModuleId], references: [id])
  pixCreditPlans         PixCreditPlan[]
  pixPlanOrders          PixPlanOrder[]
  customerPlanAccesses   CustomerPlanAccess[]
  subscriptionLinks      SubscriptionLink[]
  subscriptionLinkOrders SubscriptionLinkOrder[]
  communityAccesses      CommunityAccess[]
  communityEvents        CommunitySubscriptionEvent[]
  externalPlatformUsers  ExternalPlatformUser[]
  vouchers               Voucher[]

  @@index([email])
  @@index([domUserId])
  @@index([tenantModuleId])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
}

model Wallet {
  id            String   @id @default(uuid())
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  lockedBalance Decimal  @default(0) @db.Decimal(12, 2)
  version       Int      @default(0)
  userId        String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])
}

model BalanceLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  transactionId String?
  amount        Decimal  @db.Decimal(12, 2)
  balanceBefore Decimal  @db.Decimal(12, 2)
  balanceAfter  Decimal  @db.Decimal(12, 2)
  lockedBefore  Decimal  @db.Decimal(12, 2)
  lockedAfter   Decimal  @db.Decimal(12, 2)
  description   String?
  source        String
  metadata      Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([transactionId])
  @@index([createdAt])
}

model Transaction {
  id               String                     @id @default(uuid())
  userId           String
  amount           Decimal                    @db.Decimal(12, 2)
  netAmount        Decimal?                   @db.Decimal(12, 2)
  status           TransactionStatus          @default(DRAFT)
  previousStatus   TransactionStatus?
  paymentMethod    PaymentMethod              @default(PIX)
  description      String?
  installments     Int                        @default(1)
  totalFee         Decimal                    @default(0) @db.Decimal(12, 2)
  domFee           Decimal                    @default(0) @db.Decimal(12, 2)
  platformFee      Decimal                    @default(0) @db.Decimal(12, 2)
  domTransactionId String?                    @unique
  domPaymentId     String?                    @unique
  pixQrCode        String?
  pixContent       String?
  pixExpire        DateTime?
  cardBrand        String?
  cardBin          String?
  cardCodeAuth     String?
  customerName     String?
  customerEmail    String?
  customerDocument String?
  customerPhone    String?
  paymentLinkId    String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  paymentLink      PaymentLink?               @relation(fields: [paymentLinkId], references: [id])
  user             User                       @relation(fields: [userId], references: [id])
  statusHistory    TransactionStatusHistory[]
  pixPlanOrder     PixPlanOrder?

  @@index([userId])
  @@index([status])
  @@index([domPaymentId])
  @@index([createdAt])
  @@index([paymentMethod])
}

model TransactionStatusHistory {
  id            String            @id @default(uuid())
  transactionId String
  fromStatus    TransactionStatus
  toStatus      TransactionStatus
  metadata      Json?
  createdAt     DateTime          @default(now())
  transaction   Transaction       @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

model WithdrawRequest {
  id              String         @id @default(uuid())
  userId          String
  amount          Decimal        @db.Decimal(12, 2)
  grossAmount     Decimal        @db.Decimal(12, 2)
  fee             Decimal        @default(2.00) @db.Decimal(12, 2)
  status          WithdrawStatus @default(PENDING)
  pixKey          String
  receiptImage    String?
  rejectionReason String?
  domWithdrawId   String?        @unique
  platform        String?        @db.VarChar(50)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([platform])
}

model PaymentLink {
  id               String        @id @default(uuid())
  userId           String
  code             String        @unique @default(uuid())
  title            String
  description      String?
  amount           Decimal       @db.Decimal(12, 2)
  expiresAt        DateTime?
  maxInstallments  Int           @default(1)
  aceitaCartao     Boolean       @default(true)
  aceitaDebito     Boolean       @default(true)
  aceitaPix        Boolean       @default(true)
  isActive         Boolean       @default(true)
  isStandalone     Boolean       @default(true)
  platformFee1x    Float         @default(9.00)
  platformFee2x    Float         @default(13.30)
  platformFee3x    Float         @default(14.68)
  platformFee4x    Float         @default(16.04)
  platformFee5x    Float         @default(17.37)
  platformFee6x    Float         @default(18.67)
  platformFee7x    Float         @default(19.95)
  platformFee8x    Float         @default(21.21)
  platformFee9x    Float         @default(22.44)
  platformFee10x   Float         @default(23.64)
  platformFee11x   Float         @default(24.83)
  platformFee12x   Float         @default(25.99)
  cashbackFee      Float         @default(3.00)
  debitFeePercent  Float         @default(2.00)
  debitFeeFixed    Float         @default(2.00)
  webhookUrl       String?
  maxUses          Int?
  currentUses      Int           @default(0)
  domPaymentLinkId String?       @unique
  /// Plataformas associadas a este link de pagamento (ex: ["AREAFLIX", "PAGATG"])
  plataformas      String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])
  transactions     Transaction[]
  communityBindings CommunityLinkBinding[]

  @@index([userId])
  @@index([code])
}

// ── Subscription Link (link de assinatura com recorrência) ───────────────────
model SubscriptionLink {
  id            String    @id @default(uuid())
  userId        String
  code          String    @unique @default(uuid())
  /// E-mail da conta dona do link (para resolver userId por email)
  ownerEmail    String?
  name          String
  description   String?
  amount        Decimal   @db.Decimal(12, 2)
  frequencyType PlanType
  /// true = Avulso (cliente paga valor sem juros); false = Plataforma (aplica platformFee)
  isStandalone    Boolean   @default(true)
  platformFee     Float     @default(9.00)
  isActive        Boolean   @default(true)
  redirectUrl     String?
  webhookUrl      String?
  maxUses         Int?
  currentUses     Int       @default(0)
  domPlanId       String?   @unique
  /// Métodos aceitos: PIX, CREDIT_CARD ou BOTH (padrão)
  paymentMethods  String    @default("BOTH")
  /// Tag de plataforma para resolução de taxa (ex: AREAFLIX, COMUNIDADE, GLOBAL)
  platformTag     String?
  /// Plataformas associadas a este link (ex: ["AREAFLIX", "PAGATG"])
  plataformas     String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
  subscriptions SubscriptionLinkOrder[]
  communityBindings CommunityLinkBinding[]

  @@index([userId])
  @@index([code])
}

/// Registro de cada assinatura originada por um SubscriptionLink
model SubscriptionLinkOrder {
  id                  String    @id @default(uuid())
  subscriptionLinkId  String
  userId              String
  customerName        String
  customerEmail       String
  customerDocument    String
  customerPhone       String?
  paymentMethod       PaymentMethod @default(CREDIT_CARD)
  status              String    @default("pending")
  domSubscriptionId   String?   @unique
  domPixPaymentId     String?   @unique
  pixContent          String?
  pixExpire           DateTime?
  amountCharged       Decimal   @db.Decimal(12, 2)
  platformFeeAmount   Decimal   @default(0) @db.Decimal(12, 2)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  subscriptionLink    SubscriptionLink @relation(fields: [subscriptionLinkId], references: [id])
  user                User      @relation(fields: [userId], references: [id])
  communityEvents     CommunitySubscriptionEvent[]

  @@index([subscriptionLinkId])
  @@index([userId])
  @@index([customerEmail])
}

model Community {
  id          String                @id @default(uuid())
  slug        String                @unique
  name        String
  description String?
  source      CommunitySource       @default(AUTOMATIC)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  bindings    CommunityLinkBinding[]
  accesses    CommunityAccess[]
  events      CommunitySubscriptionEvent[]

  @@index([slug])
}

model CommunityLinkBinding {
  id                 String            @id @default(uuid())
  communityId        String
  bindingType        CommunityLinkType
  subscriptionLinkId String?
  paymentLinkId      String?
  isManual           Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  community          Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  subscriptionLink   SubscriptionLink? @relation(fields: [subscriptionLinkId], references: [id], onDelete: Cascade)
  paymentLink        PaymentLink?      @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([subscriptionLinkId])
  @@index([paymentLinkId])
}

model CommunityAccess {
  id               String          @id @default(uuid())
  communityId      String
  userId           String
  status           CommunityStatus @default(ATIVA)
  isActive         Boolean         @default(true)
  statusReason     String?
  startedAt        DateTime
  expiresAt        DateTime
  totalDaysCredited Int            @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  community        Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
  @@index([userId])
  @@index([isActive])
}

model CommunitySubscriptionEvent {
  id                      String                   @id @default(uuid())
  communityId             String
  userId                  String
  eventType               CommunityEventType
  paymentMethod           PaymentMethod?
  amountCharged           Decimal?                 @db.Decimal(12, 2)
  subscriptionLinkOrderId String?
  metadata                Json?
  createdAt               DateTime                 @default(now())
  community               Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionLinkOrder   SubscriptionLinkOrder?   @relation(fields: [subscriptionLinkOrderId], references: [id], onDelete: SetNull)

  @@index([communityId])
  @@index([userId])
  @@index([eventType])
}

model Plan {
  id            String         @id @default(uuid())
  userId        String
  name          String
  description   String?
  price         Decimal        @db.Decimal(12, 2)
  type          PlanType
  isActive      Boolean        @default(true)
  webhookUrl    String?
  redirectUrl   String?
  domPlanId      String?        @unique
  code           String?        @unique
  paymentMethods String?        @default("BOTH")
  /// Plataformas associadas a este plano (ex: ["AREAFLIX", "PAGATG"])
  plataformas    String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  subscriptions Subscription[]

  @@index([userId])
}

model Subscription {
  id                String    @id @default(uuid())
  userId            String
  planId            String
  customerId        String?
  status            String    @default("active")
  expiresAt         DateTime?
  totalDaysCredited Int       @default(0)
  domSubscriptionId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  customer          Customer? @relation(fields: [customerId], references: [id])
  plan              Plan      @relation(fields: [planId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([planId])
  @@index([status])
}

/// Guarda o estado de pausa de uma assinatura DOM.
/// Criado ao pausar (após cancelar na DOM) e destruído ao retomar.
/// Não toca em nada do fluxo normal — só existe se o admin pausar.
model SubscriptionPause {
  id                String   @id @default(uuid())
  /// ID da assinatura na DOM (mesmo campo usado em Subscription.domSubscriptionId)
  domSubscriptionId String   @unique
  userId            String
  /// Snapshot dos dados de exibição (a assinatura some da listagem DOM após cancelamento)
  subscriberName    String?
  customerEmail     String?
  description       String?
  planId            String?
  valueBrl          Float?
  frequency         String?
  interval          Int      @default(1)
  plataforma        String?
  firstCharge       String?
  /// Dias restantes calculados no momento da pausa (expiresAt - pausedAt)
  remainingDays     Int
  pausedAt          DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model Customer {
  id                   String               @id @default(uuid())
  userId               String
  name                 String
  email                String
  document             String
  documentType         String               @default("CPF")
  phone                String?
  domCustomerId        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id])
  subscriptions        Subscription[]
  pixPlanOrders        PixPlanOrder[]
  customerPlanAccesses CustomerPlanAccess[]

  @@unique([userId, document])
  @@index([email])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  source      String
  eventType   String
  payload     Json
  status      String    @default("PENDING")
  retryCount  Int       @default(0)
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([status])
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  webhookUrl         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TenantModule {
  id        String   @id @default(uuid())
  name      String // Ex: "Revalida", "Renovada"
  slug      String   @unique // Ex: "revalida", "renovada" — usado p/ env var {SLUG}_DOM_TOKEN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@index([slug])
}

model Lead {
  id              String     @id @default(uuid())
  name            String
  phone           String
  email           String
  razaoSocial     String
  cnpj            String
  cpf             String?
  faturamento     String
  tempoOperacao   String
  modeloOperacao  String?
  cargo           String
  comoConheceu    String?
  status          LeadStatus @default(PENDING)
  rejectionReason String?
  approvedUserId  String?    @unique
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([email])
  @@index([cnpj])
}

enum Role {
  USER
  ADMIN
}

enum TransactionStatus {
  DRAFT
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  EXPIRED
  IN_MEDIATION
  CHARGEBACK
  PENDING_REFUND
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum WithdrawStatus {
  PENDING
  APPROVED
  COMPLETED
  REJECTED
}

enum PlanType {
  MONTHLY
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum CommunitySource {
  AUTOMATIC
  MANUAL
}

enum CommunityLinkType {
  SUBSCRIPTION_LINK
  PAYMENT_LINK
}

enum CommunityStatus {
  ATIVA
  INADIMPLENTE
  PLANO_ENCERRADO
  INATIVA
}

enum CommunityEventType {
  ACTIVATED
  RENEWED
  PIX_PENDING
  EXPIRED
  MANUAL_ADJUST
}

enum LeadStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── External Platform Users (donos de plataformas externas, ex: ebook) ────────
// Representa usuários identificados via CPF nas descrições de transações.
// Quando o usuário se cadastra na Simpay com o mesmo CPF, é feita a vinculação.
model ExternalPlatformUser {
  id          String                   @id @default(uuid())
  cpf         String
  name        String
  platform    String                   // slug da plataforma ex: "ebook"
  userId      String?                  // vinculado ao User da Simpay quando se cadastra
  isDeleted   Boolean                  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  wallet      ExternalPlatformWallet?
  user        User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([cpf, platform])
  @@index([cpf])
  @@index([platform])
  @@index([userId])
}

model ExternalPlatformWallet {
  id                   String               @id @default(uuid())
  externalUserId       String               @unique
  balance              Decimal              @default(0) @db.Decimal(12, 2)
  lockedBalance        Decimal              @default(0) @db.Decimal(12, 2)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  externalUser         ExternalPlatformUser @relation(fields: [externalUserId], references: [id])
}

// ── PIX Credit Plan (crédito de dias via PIX) ─────────────────────────────

model PixCreditPlan {
  id          String               @id @default(uuid())
  userId      String
  type        PlanType
  price       Float
  description String?
  redirectUrl String?
  webhookUrl  String?
  status      String               @default("ACTIVE")
  /// Tag da plataforma vinculada (ex: PAGATG, AREAFLIX, RENOVADA)
  tenantTag   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkCodes   PixPlanLinkCode[]
  orders      PixPlanOrder[]
  accesses    CustomerPlanAccess[]

  @@index([userId])
  @@index([status])
  @@index([tenantTag])
}

model PixPlanLinkCode {
  id              String        @id @default(uuid())
  code            String        @unique
  pixCreditPlanId String
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  pixCreditPlan   PixCreditPlan @relation(fields: [pixCreditPlanId], references: [id])

  @@index([pixCreditPlanId])
  @@index([isActive])
}

model PixPlanOrder {
  id               String         @id @default(uuid())
  transactionId    String         @unique
  userId           String
  customerId       String?
  customerEmail    String
  customerDocument String
  planType         PlanType
  daysCredited     Int
  pixCreditPlanId  String?
  paid             Boolean        @default(false)
  creditedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  transaction      Transaction    @relation(fields: [transactionId], references: [id])
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer         Customer?      @relation(fields: [customerId], references: [id])
  pixCreditPlan    PixCreditPlan? @relation(fields: [pixCreditPlanId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([customerDocument])
  @@index([customerId])
  @@index([pixCreditPlanId])
}

model CustomerPlanAccess {
  id                String         @id @default(uuid())
  userId            String
  customerId        String
  pixPlanId         String?
  pixPlanCode       String?
  customerEmail     String
  customerDocument  String
  isActive          Boolean        @default(false)
  expiresAt         DateTime
  totalDaysCredited Int            @default(0)
  lastTransactionId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer          Customer       @relation(fields: [customerId], references: [id])
  pixPlan           PixCreditPlan? @relation(fields: [pixPlanId], references: [id], onDelete: SetNull)

  @@unique([userId, customerDocument, pixPlanId])
  @@unique([userId, customerId, pixPlanId])
  @@index([userId])
  @@index([customerEmail])
  @@index([pixPlanId])
}

model PlatformTaxaOverride {
  id        String   @id @default(uuid())
  tag       String
  key       String
  value     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tag, key])
  @@index([tag])
}

// ── Vouchers ──────────────────────────────────────────────────────────────────

model Voucher {
  id               String         @id @default(uuid())
  userId           String
  code             String
  description      String?
  discountType     DiscountType
  discountValue    Float
  maxUsage         Int?
  maxDiscountValue Float?
  validFrom        DateTime?
  validUntil       DateTime?
  applicablePlans  String[]
  minOrderValue    Float?
  allowedChannels  String[]       @default(["PAGATG"])
  allowedLinkCodes String[]       @default([])
  isActive         Boolean        @default(true)
  usageCount       Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages           VoucherUsage[]

  @@unique([code])
  @@index([userId])
  @@index([code])
}

model VoucherUsage {
  id               String   @id @default(uuid())
  voucherId        String
  transactionId    String?
  subscriptionId   String?
  customerEmail    String
  customerDocument String
  originalAmount   Float
  discountAmount   Float
  finalAmount      Float
  createdAt        DateTime @default(now())
  voucher          Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}
